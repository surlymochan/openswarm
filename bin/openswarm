# ---------------------------------------------------------------- utils

def jload(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def jsave(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def deep_merge(a, b):
    out = dict(a)
    for k, v in (b or {}).items():
        out[k] = deep_merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def load_policy():
    base = jload(f"{SKILL_DIR}/policy.json", {})
    local = jload(f"{DATA}/policy.local.json", {})
    # Older policy.local.json files used `concurrency` for quota-based recommendations.
    if isinstance(local.get("concurrency"), list):
        local = dict(local)
        local.setdefault("recommended_concurrency", local["concurrency"])
        local["concurrency"] = {}
    return deep_merge(base, local)


def configured_card_types(policy):
    """Return the configured card types, or None when no list is available."""
    repo = os.path.expanduser(str((policy.get("knowledge") or {}).get("repo") or DEFAULT_KNOWLEDGE_REPO))
    path = os.path.join(repo, "card-types.yaml")
    try:
        with open(path, encoding="utf-8") as stream:
            lines = stream.read().splitlines()
    except FileNotFoundError:
        return None

    def scalar(value):
        value = value.split(" #", 1)[0].strip().rstrip(",")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        return value.strip()

    def list_value(value):
        value = scalar(value)
        if value.startswith(("name:", "id:", "type:")):
            value = scalar(value.split(":", 1)[1])
        return value

    values, root_keys, section_indent, in_section, recognized = set(), set(), None, False, False
    section_keys = {"card_types", "card-types", "types"}
    for line in lines:
        content = line.split(" #", 1)[0].rstrip()
        if not content.strip() or content.lstrip().startswith("#"):
            continue
        indent = len(content) - len(content.lstrip())
        stripped = content.strip()
        if indent == 0 and stripped.startswith("-"):
            recognized = True
            value = list_value(stripped[1:])
            if value:
                values.add(value)
            continue
        match = re.match(r"^([A-Za-z0-9_-]+):(?:\s*(.*))?$", stripped)
        if match:
            key, rest = match.group(1), (match.group(2) or "").strip()
            if indent == 0 and key in section_keys:
                in_section, recognized, section_indent = True, True, indent
                if rest.startswith("[") and rest.endswith("]"):
                    values.update(v for v in (scalar(item) for item in rest[1:-1].split(",")) if v)
                elif rest:
                    value = scalar(rest)
                    if value:
                        values.add(value)
                continue
            if indent == 0:
                root_keys.add(key)
            if in_section and indent > (section_indent or 0):
                # Mapping-form type definitions use their keys as the allowed values.
                if not rest or rest.startswith("{"):
                    values.add(key)
                elif key in ("name", "id", "type"):
                    value = scalar(rest)
                    if value:
                        values.add(value)
                continue
            if indent == 0:
                in_section = False
        if in_section and stripped.startswith("-"):
            value = list_value(stripped[1:])
            if value:
                values.add(value)
    return values if recognized else root_keys


def validate_card_type(policy, card_type):
    if card_type is None:
        return
    known = configured_card_types(policy)
    if known is not None and card_type not in known:
        raise ValueError(f"unknown card type: {card_type}")


DEFAULT_KNOWLEDGE_REPO = "~/work/agent-knowledge"
LESSONS_MAX_COUNT = 12
LESSONS_MAX_CHARS = 3000
LESSONS_HEADER = "Lessons (L3 entries are reminders):\n"
LESSON_FIELDS = {"id", "rule", "guard_level", "applies_to"}
LESSON_APPLIES_TO_FIELDS = {"card_types", "paths", "backends"}
PATTERNS_MAX_COUNT = 3
PATTERNS_MAX_CHARS = 1500
PATTERNS_HEADER = "Patterns:\n"
PATTERN_APPLIES_TO_FIELDS = {"card_types", "paths", "backends"}


def lesson_yaml_comment(line):
    quote, escaped = None, False
    for index, char in enumerate(line):
        if quote == '"' and escaped:
            escaped = False
            continue
        if quote == '"' and char == "\\":
            escaped = True
            continue
        if quote and char == quote:
            quote = None
        elif not quote and char in ("'", '"'):
            quote = char
        elif not quote and char == "#" and (index == 0 or line[index - 1].isspace()):
            return line[:index]
    return line


def lesson_yaml_scalar(raw, allow_list=False):
    value = raw.strip()
    if allow_list and value.startswith("["):
        if not value.endswith("]"):
            raise ValueError("unterminated inline list")
        inner = value[1:-1].strip()
        if not inner:
            return []
        items, start, quote, escaped = [], 0, None, False
        for index, char in enumerate(inner):
            if quote == '"' and escaped:
                escaped = False
                continue
            if quote == '"' and char == "\\":
                escaped = True
                continue
            if quote and char == quote:
                quote = None
            elif not quote and char in ("'", '"'):
                quote = char
            elif not quote and char == ",":
                items.append(inner[start:index].strip())
                start = index + 1
        if quote:
            raise ValueError("unterminated quoted list item")
        items.append(inner[start:].strip())
        if any(not item for item in items):
            raise ValueError("inline list contains an empty item")
        return [lesson_yaml_scalar(item) for item in items]
    if not value:
        raise ValueError("expected a scalar")
    if value[0] in ("'", '"'):
        if len(value) < 2 or value[-1] != value[0]:
            raise ValueError("unterminated quoted scalar")
        if value[0] == '"':
            try:
                parsed = json.loads(value)
            except ValueError as error:
                raise ValueError("invalid double-quoted scalar") from error
        else:
            inner = value[1:-1]
            parsed_parts, index = [], 0
            while index < len(inner):
                if inner[index] == "'":
                    if index + 1 >= len(inner) or inner[index + 1] != "'":
                        raise ValueError("invalid single-quoted scalar")
                    parsed_parts.append("'")
                    index += 2
                else:
                    parsed_parts.append(inner[index])
                    index += 1
            parsed = "".join(parsed_parts)
        if value[0] == "'" and "'" in value[1:-1].replace("''", ""):
            raise ValueError("invalid single-quoted scalar")
        if not isinstance(parsed, str) or not parsed:
            raise ValueError("expected a non-empty string scalar")
        return parsed
    if value in ("~", "null", "Null", "NULL"):
        return None
    if value.casefold() == "true":
        return True
    if value.casefold() == "false":
        return False
    if re.fullmatch(r"[+-]?[0-9]+", value):
        return int(value)
    if (value[0] in "&*!|>{}[]" or value.startswith(("- ", "? "))
            or ": " in value):
        raise ValueError("unsupported YAML scalar syntax")
    return value


def parse_lesson_yaml(text, require_lesson=True):
    """Parse a mapping from the repository's small YAML subset."""
    lesson, applies, active_map = {}, {}, None
    for number, original in enumerate(text.splitlines(), 1):
        content = lesson_yaml_comment(original).rstrip()
        if not content.strip():
            continue
        if "\t" in content:
            raise ValueError(f"line {number}: tabs are not supported")
        indent = len(content) - len(content.lstrip(" "))
        stripped = content.strip()
        if indent == 0:
            active_map = None
            match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_-]*):(?:[ \t]*(.*))?", stripped)
            if not match:
                raise ValueError(f"line {number}: expected a top-level key and scalar")
            key, raw = match.group(1), (match.group(2) or "").strip()
            if key in lesson:
                raise ValueError(f"line {number}: duplicate key {key!r}")
            if key == "applies_to":
                if raw:
                    raise ValueError(f"line {number}: applies_to must be a nested mapping")
                lesson[key] = applies
                active_map = "applies_to"
            else:
                lesson[key] = lesson_yaml_scalar(raw)
        elif indent == 2 and active_map == "applies_to":
            match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_-]*):[ \t]*(.*)", stripped)
            if not match:
                raise ValueError(f"line {number}: expected an applies_to list")
            key, raw = match.group(1), match.group(2).strip()
            if key not in LESSON_APPLIES_TO_FIELDS:
                raise ValueError(f"line {number}: unsupported applies_to key {key!r}")
            if key in applies:
                raise ValueError(f"line {number}: duplicate applies_to key {key!r}")
            values = lesson_yaml_scalar(raw, allow_list=True)
            if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
                raise ValueError(f"line {number}: applies_to.{key} must be an inline list")
            applies[key] = values
        else:
            raise ValueError(f"line {number}: unsupported indentation or nested mapping")
    if require_lesson:
        missing = LESSON_FIELDS - lesson.keys()
        if missing:
            raise ValueError("missing required field(s): " + ", ".join(sorted(missing)))
        if (not isinstance(lesson["id"], str)
                or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,79}", lesson["id"])):
            raise ValueError("id must contain only letters, digits, dot, underscore, or hyphen")
        for key in LESSON_APPLIES_TO_FIELDS:
            lesson["applies_to"].setdefault(key, [])
    return lesson


def lesson_path_matches(pattern, card_text, paths):
    pattern = str(pattern).replace("\\", "/").strip()
    text = str(card_text or "").replace("\\", "/")
    candidates = [str(path).replace("\\", "/").strip() for path in (paths or []) if str(path).strip()]
    candidates.extend(re.findall(r"(?<![\w.-])(?:\.{1,2}/)?[A-Za-z0-9_@.+-]+(?:/[A-Za-z0-9_.*?+{}@+-]+)+(?:\.[A-Za-z0-9_+-]+)?", text))
    if any(fnmatch.fnmatchcase(candidate, pattern) for candidate in candidates):
        return True
    if not any(char in pattern for char in "*?["):
        return pattern in text
    return False


def select_lessons(policy, card_type=None, backend=None, card_text="", paths=None):
    repo = os.path.expanduser(str((policy.get("knowledge") or {}).get("repo") or DEFAULT_KNOWLEDGE_REPO))
    directory = os.path.join(repo, "lessons")
    try:
        filenames = sorted(name for name in os.listdir(directory) if name.endswith(".yaml"))
    except FileNotFoundError:
        return "", []
    except OSError as error:
        print(f"openswarm: warning: cannot read lessons directory {directory}: {error}", file=sys.stderr)
        return "", []
    matched = []
    for filename in filenames:
        path = os.path.join(directory, filename)
        try:
            with open(path, encoding="utf-8") as stream:
                lesson = parse_lesson_yaml(stream.read())
        except (OSError, ValueError) as error:
            print(f"openswarm: warning: skipping lesson file {path}: {error}", file=sys.stderr)
            continue
        if lesson["guard_level"] not in ("L2", "L3"):
            continue
        applies = lesson["applies_to"]
        if applies["card_types"] and card_type not in applies["card_types"]:
            continue
        if applies["backends"] and backend not in applies["backends"]:
            continue
        if applies["paths"] and not any(lesson_path_matches(pattern, card_text, paths) for pattern in applies["paths"]):
            continue
        path_literals = [sum(char not in "*?[]" for char in pattern) for pattern in applies["paths"]]
        dimensions = sum(bool(applies[key]) for key in ("card_types", "paths", "backends"))
        selector_size = sum(len(applies[key]) for key in ("card_types", "paths", "backends"))
        specificity = (-dimensions, -max(path_literals, default=0), selector_size, lesson["id"])
        matched.append((specificity, lesson))
    matched.sort(key=lambda item: item[0])
    lines, ids, length = [], [], len(LESSONS_HEADER)
    for _, lesson in matched:
        rule = " ".join(lesson["rule"].split())
        line = f"[{lesson['id']}] {rule}"
        added = len(line) + (1 if lines else 0)
        if len(lines) >= LESSONS_MAX_COUNT or length + added > LESSONS_MAX_CHARS:
            continue
        lines.append(line)
        ids.append(lesson["id"])
        length += added
    return (LESSONS_HEADER + "\n".join(lines), ids) if lines else ("", [])


def add_lessons_to_prompt(prompt, policy, card_type=None, backend=None, card_text="", paths=None):
    block, ids = select_lessons(policy, card_type, backend, card_text, paths)
    if block:
        separator = "\n\n" + block + "\n\n"
        report_at = prompt.rfind(REPORT_INSTRUCTION)
        if report_at >= 0:
            prompt = prompt[:report_at] + separator + prompt[report_at:]
        else:
            prompt += separator
    return prompt, ids


def parse_pattern_markdown(text):
    """Parse the deliberately small YAML front matter used by curated patterns."""
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        raise ValueError("pattern must start with YAML front matter")
    try:
        end = lines.index("---", 1)
    except ValueError as error:
        raise ValueError("pattern front matter is not closed") from error
    pattern, applies, active_map = {}, {}, None
    for number, original in enumerate(lines[1:end], 2):
        content = lesson_yaml_comment(original).rstrip()
        if not content.strip():
            continue
        if "\t" in content:
            raise ValueError(f"line {number}: tabs are not supported")
        indent = len(content) - len(content.lstrip(" "))
        stripped = content.strip()
        if indent == 0:
            active_map = None
            match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_-]*):(?:[ \t]*(.*))?", stripped)
            if not match:
                raise ValueError(f"line {number}: expected a front matter key and scalar")
            key, raw = match.group(1), (match.group(2) or "").strip()
            if key in pattern:
                raise ValueError(f"line {number}: duplicate key {key!r}")
            if key == "applies_to":
                if raw:
                    raise ValueError(f"line {number}: applies_to must be a nested mapping")
                pattern[key] = applies
                active_map = "applies_to"
            else:
                pattern[key] = lesson_yaml_scalar(raw)
        elif indent == 2 and active_map == "applies_to":
            match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_-]*):[ \t]*(.*)", stripped)
            if not match:
                raise ValueError(f"line {number}: expected an applies_to list")
            key, raw = match.group(1), match.group(2).strip()
            if key not in PATTERN_APPLIES_TO_FIELDS:
                raise ValueError(f"line {number}: unsupported applies_to key {key!r}")
            if key in applies:
                raise ValueError(f"line {number}: duplicate applies_to key {key!r}")
            values = lesson_yaml_scalar(raw, allow_list=True)
            if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
                raise ValueError(f"line {number}: applies_to.{key} must be an inline list")
            applies[key] = values
        else:
            raise ValueError(f"line {number}: unsupported indentation or nested mapping")
    required = {"id", "title", "applies_to", "source", "status"}
    missing = required - pattern.keys()
    if missing:
        raise ValueError("missing required field(s): " + ", ".join(sorted(missing)))
    if not isinstance(pattern["id"], str) or not re.fullmatch(r"P-\d{4,}", pattern["id"]):
        raise ValueError("id must use the P-0001 pattern ID format")
    if not isinstance(pattern["title"], str) or not isinstance(pattern["source"], str):
        raise ValueError("title and source must be strings")
    if pattern["status"] not in ("active", "retired"):
        raise ValueError("status must be active or retired")
    for key in PATTERN_APPLIES_TO_FIELDS:
        applies.setdefault(key, [])
    body = "\n".join(lines[end + 1:]).strip()
    if not body:
        raise ValueError("pattern body must not be empty")
    pattern["body"] = body
    return pattern


def select_patterns(policy, card_type=None, backend=None, card_text="", paths=None):
    repo = os.path.expanduser(str((policy.get("knowledge") or {}).get("repo") or DEFAULT_KNOWLEDGE_REPO))
    directory = os.path.join(repo, "skills")
    try:
        filenames = sorted(name for name in os.listdir(directory) if name.endswith(".md") and name != "README.md")
    except FileNotFoundError:
        return "", []
    except OSError as error:
        print(f"openswarm: warning: cannot read patterns directory {directory}: {error}", file=sys.stderr)
        return "", []
    matched = []
    for filename in filenames:
        path = os.path.join(directory, filename)
        try:
            with open(path, encoding="utf-8") as stream:
                pattern = parse_pattern_markdown(stream.read())
        except (OSError, ValueError) as error:
            print(f"openswarm: warning: skipping pattern file {path}: {error}", file=sys.stderr)
            continue
        if pattern["status"] != "active":
            continue
        applies = pattern["applies_to"]
        if applies["card_types"] and card_type not in applies["card_types"]:
            continue
        if applies["backends"] and backend not in applies["backends"]:
            continue
        if applies["paths"] and not any(lesson_path_matches(item, card_text, paths) for item in applies["paths"]):
            continue
        path_literals = [sum(char not in "*?[]" for char in item) for item in applies["paths"]]
        dimensions = sum(bool(applies[key]) for key in PATTERN_APPLIES_TO_FIELDS)
        selector_size = sum(len(applies[key]) for key in PATTERN_APPLIES_TO_FIELDS)
        specificity = (-dimensions, -max(path_literals, default=0), selector_size, pattern["id"])
        matched.append((specificity, pattern))
    matched.sort(key=lambda item: item[0])

    lines, ids = [], []
    rendered = PATTERNS_HEADER.rstrip()
    for _, pattern in matched:
        if len(ids) >= PATTERNS_MAX_COUNT:
            break
        prefix = f"[{pattern['id']}] {pattern['title']}\n"
        separator = "\n\n" if ids else "\n"
        remaining = PATTERNS_MAX_CHARS - len(rendered) - len(separator) - len(prefix)
        if remaining <= 0:
            continue
        body = pattern["body"]
        if len(body) > remaining:
            body = body[:max(0, remaining - 1)].rstrip() + "…"
        lines.append(prefix + body)
        ids.append(pattern["id"])
        rendered += separator + lines[-1]
        if len(rendered) >= PATTERNS_MAX_CHARS:
            break
    return (rendered, ids) if ids else ("", [])


def add_patterns_to_prompt(prompt, policy, card_type=None, backend=None, card_text="", paths=None):
    block, ids = select_patterns(policy, card_type, backend, card_text, paths)
    if block:
        separator = "\n\n" + block + "\n\n"
        report_at = prompt.rfind(REPORT_INSTRUCTION)
        if report_at >= 0:
            prompt = prompt[:report_at] + separator + prompt[report_at:]
        else:
            prompt += separator
    return prompt, ids


def pattern_knowledge_repo(policy):
    return os.path.expanduser(str((policy.get("knowledge") or {}).get("repo") or DEFAULT_KNOWLEDGE_REPO))


def pattern_yaml_quote(value):
    return json.dumps(str(value), ensure_ascii=False)


def pattern_draft_text(pattern_id, title, applies_to, source, body):
    lines = ["---", "proposal_type: pattern_draft", f"id: {pattern_yaml_quote(pattern_id)}",
             f"title: {pattern_yaml_quote(title)}", "applies_to:"]
    for key in ("card_types", "paths", "backends"):
        values = ", ".join(pattern_yaml_quote(item) for item in applies_to.get(key, []))
        lines.append(f"  {key}: [{values}]")
    lines.extend([f"source: {pattern_yaml_quote(source)}", "status: active", "---", body.strip(), ""])
    return "\n".join(lines)


def pattern_next_id(repo):
    highest = 0
    for base in (os.path.join(repo, "skills"), os.path.join(repo, "proposals")):
        for path in glob.glob(os.path.join(base, "**", "*.md"), recursive=True):
            try:
                with open(path, encoding="utf-8") as stream:
                    text = stream.read(2000)
            except OSError:
                continue
            for match in re.finditer(r"(?m)^id:\s*[\"']?P-(\d+)", text):
                highest = max(highest, int(match.group(1)))
    return highest + 1


def pattern_existing_sources(repo):
    sources = set()
    for path in glob.glob(os.path.join(repo, "proposals", "**", "*.md"), recursive=True):
        try:
            with open(path, encoding="utf-8") as stream:
                lines = stream.readlines()
        except OSError:
            continue
        if not lines or lines[0].strip() != "---":
            continue
        for line in lines[1:]:
            if line.strip() == "---":
                break
            match = re.fullmatch(r"source:\s*(.*)\s*", line.strip())
            if match:
                try:
                    sources.add(lesson_yaml_scalar(match.group(1)))
                except ValueError:
                    pass
                break
    return sources


def pattern_proposal_timestamp(path, report=None):
    if isinstance(report, dict):
        timestamp = to_epoch(report.get("created_at"))
        if timestamp is not None:
            return timestamp
    date_match = re.fullmatch(r"\d{4}-\d{2}-\d{2}", os.path.basename(os.path.dirname(path)))
    if date_match:
        try:
            return dt.datetime.fromisoformat(date_match.group(0)).timestamp()
        except ValueError:
            pass
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0


def pattern_report_for_proposal(path):
    filename = os.path.basename(path)
    match = re.fullmatch(r"pattern-(.+)\.md", filename)
    compare_id = match.group(1) if match else None
    if not compare_id or compare_id.startswith("draft-"):
        return compare_id, None
    report = jload(os.path.join(RUNS, compare_id, "compare.json"))
    return compare_id, report if isinstance(report, dict) else None


def pattern_apply_paths(paths):
    values = set()
    for path in paths:
        if not isinstance(path, str) or not path.strip():
            continue
        value = path.strip().replace("\\", "/")
        if value.startswith("./"):
            value = value[2:]
        if value:
            values.add(value)
    values = sorted(values)
    if not values:
        return []
    roots = {value.split("/", 1)[0] for value in values}
    if len(roots) == 1 and any("/" in value for value in values):
        return [next(iter(roots)) + "/**"]
    return values if len(values) == 1 else []


def pattern_compare_draft(source_path, output_dir, compare_id, report):
    report = report or {}
    card_type = report.get("card_type")
    title = str(report.get("title") or "").strip()
    winner_label = report.get("winner_label")
    winner = (report.get("runs") or {}).get(str(winner_label or "").lower(), {})
    winner_result = winner.get("result") if isinstance(winner.get("result"), dict) else {}
    backend = winner.get("backend")
    display = f"{card_type} cards" if card_type else "similar cards"
    draft_title = (f"Reuse the winning {backend} approach for {display}" if backend
                   else f"Review the winning approach for {display}")
    notes = [" ".join(str(note).split()) for note in report.get("diff_notes") or [] if str(note).strip()]
    if not notes:
        try:
            with open(source_path, encoding="utf-8") as stream:
                proposal = stream.read()
        except OSError:
            proposal = ""
        section = re.search(r"(?ms)^## Proposed pattern\s*\n+(.*?)(?:\n## |\Z)", proposal)
        note = " ".join((section.group(1) if section else "").split())
        notes = [note] if note else ["Inspect the comparison evidence before adopting its approach."]
    examples = []
    nested = winner_result.get("result")
    if isinstance(nested, dict):
        examples.extend(nested.get("files_changed") or [])
    if isinstance(winner_result.get("files_changed"), list):
        examples.extend(winner_result["files_changed"])
    example_target = os.path.relpath(source_path, output_dir).replace(os.sep, "/")
    context = f" for {card_type} cards" if card_type else ""
    if title:
        context += f" like {title!r}"
    body_lines = [f"When to use: Review this approach for similar tasks{context}.", "Pattern:"]
    body_lines.extend(f"- {note[:220]}" for note in notes[:2])
    body_lines.extend(["- Verify the winner's changed paths and checks before reusing its approach.",
                       "- Adapt the approach to the current card and preserve relevant tests.",
                       f"Example: [compare proposal]({example_target})"])
    body = "\n".join(body_lines)
    applies = {"card_types": [card_type] if isinstance(card_type, str) and card_type else [],
               "paths": pattern_apply_paths(examples), "backends": [backend] if isinstance(backend, str) and backend else []}
    return draft_title, applies, f"compare {compare_id}", body


def pattern_review_groups(repo, cutoff):
    groups = {}
    for entry in ledger_entries():
        timestamp = to_epoch(entry.get("ts"))
        if timestamp is None or timestamp < cutoff:
            continue
        run_id = entry.get("run_id") or entry.get("id")
        if not run_id:
            continue
        review_path = os.path.join(RUNS, str(run_id), "review.json")
        review = jload(review_path)
        if not isinstance(review, dict) or not isinstance(review.get("findings"), list):
            continue
        for finding in review["findings"]:
            if not isinstance(finding, dict) or not isinstance(finding.get("title"), str):
                continue
            title = " ".join(finding["title"].split()).strip()
            key = re.sub(r"[^a-z0-9]+", " ", title.casefold()).strip()
            if not key:
                continue
            group = groups.setdefault(key, {"title": title, "runs": {}})
            group["runs"][str(run_id)] = {"entry": entry, "path": review_path, "finding": finding}
    return {key: group for key, group in groups.items() if len(group["runs"]) >= 2}


def pattern_review_draft(group_key, group, output_dir):
    records = list(group["runs"].items())
    run_ids = sorted(group["runs"])
    sample = records[0][1]
    finding = sample["finding"]
    paths = [item["finding"].get("path") for item in group["runs"].values()]
    card_types = sorted({str(item["entry"].get("card_type")) for item in group["runs"].values()
                         if item["entry"].get("card_type")})
    backends = sorted({str(item["entry"].get("backend")) for item in group["runs"].values()
                       if item["entry"].get("backend")})
    body_text = " ".join(str(finding.get("body") or "").split())[:350]
    if not body_text:
        body_text = group["title"]
    review_path = sample["path"]
    pr_url = (sample["entry"].get("pr") or {}).get("url") if isinstance(sample["entry"].get("pr"), dict) else None
    if pr_url:
        example = f"[review evidence]({pr_url})"
    else:
        example_path = os.path.relpath(review_path, output_dir).replace(os.sep, "/")
        example = f"[review run {run_ids[0]}]({example_path})"
    body = "\n".join(("When to use: Check for this issue when working in similar code paths.", "Pattern:",
                       f"- {group['title']}.", f"- {body_text}", "- Add a regression test for the reported case.",
                       f"Example: {example}"))
    applies = {"card_types": card_types, "paths": pattern_apply_paths(paths), "backends": backends}
    source_hash = hashlib.sha256(group_key.encode("utf-8")).hexdigest()[:12]
    return group["title"], applies, f"review finding {source_hash} ({', '.join(run_ids)})", body, source_hash


def cmd_patterns_propose(args, policy):
    if not math.isfinite(args.since) or args.since <= 0:
        raise ValueError("--since must be a positive number of days")
    repo = pattern_knowledge_repo(policy)
    proposals_root = os.path.join(repo, "proposals")
    date = policy_day(policy)[0]
    output_dir = os.path.join(proposals_root, date)
    os.makedirs(output_dir, exist_ok=True)
    cutoff = NOW() - args.since * 86400
    existing_sources = pattern_existing_sources(repo)
    next_number = pattern_next_id(repo)
    written, skipped = [], 0

    compare_paths = sorted(glob.glob(os.path.join(proposals_root, "*", "pattern-*.md")))
    for source_path in compare_paths:
        try:
            with open(source_path, encoding="utf-8") as stream:
                source_text = stream.read()
        except OSError:
            continue
        if source_text.startswith("---\n") and "proposal_type: pattern_draft" in source_text.split("---", 2)[1]:
            continue
        compare_id, report = pattern_report_for_proposal(source_path)
        if not compare_id or pattern_proposal_timestamp(source_path, report) < cutoff:
            continue
        source = f"compare {compare_id}"
        if source in existing_sources:
            skipped += 1
            continue
        pattern_id = f"P-{next_number:04d}"
        next_number += 1
        title, applies, source, body = pattern_compare_draft(source_path, output_dir, compare_id, report)
        destination = os.path.join(output_dir, f"pattern-draft-compare-{compare_id}.md")
        if os.path.exists(destination):
            skipped += 1
            continue
        with open(destination, "x", encoding="utf-8") as stream:
            stream.write(pattern_draft_text(pattern_id, title, applies, source, body))
        existing_sources.add(source)
        written.append(destination)

    for group_key, group in sorted(pattern_review_groups(repo, cutoff).items()):
        title, applies, source, body, source_hash = pattern_review_draft(group_key, group, output_dir)
        if source in existing_sources:
            skipped += 1
            continue
        pattern_id = f"P-{next_number:04d}"
        next_number += 1
        destination = os.path.join(output_dir, f"pattern-draft-review-{source_hash}.md")
        if os.path.exists(destination):
            skipped += 1
            continue
        with open(destination, "x", encoding="utf-8") as stream:
            stream.write(pattern_draft_text(pattern_id, title, applies, source, body))
        existing_sources.add(source)
        written.append(destination)
    print(json.dumps({"proposals": written, "count": len(written), "skipped": skipped}, ensure_ascii=False))


def pattern_rates(entries, field):
    values = [entry[field] for entry in entries if isinstance(entry.get(field), bool)]
    return (sum(values) / len(values), len(values)) if values else (None, 0)


def cmd_patterns_retire_check(args, policy):
    repo = pattern_knowledge_repo(policy)
    skills_dir = os.path.join(repo, "skills")
    try:
        filenames = sorted(name for name in os.listdir(skills_dir) if name.endswith(".md") and name != "README.md")
    except FileNotFoundError:
        filenames = []
    cutoff = NOW() - 30 * 86400
    recent = [entry for entry in ledger_entries()
              if (to_epoch(entry.get("ts")) or 0) >= cutoff]
    date = policy_day(policy)[0]
    output_dir = os.path.join(repo, "proposals", date)
    written, checked, insufficient = [], 0, 0
    for filename in filenames:
        path = os.path.join(skills_dir, filename)
        try:
            with open(path, encoding="utf-8") as stream:
                pattern = parse_pattern_markdown(stream.read())
        except (OSError, ValueError) as error:
            print(f"openswarm: warning: skipping pattern file {path}: {error}", file=sys.stderr)
            continue
        if pattern["status"] != "active":
            continue
        checked += 1
        groups = {}
        for entry in recent:
            card_type, backend = entry.get("card_type"), entry.get("backend")
            if not isinstance(card_type, str) or not card_type or not isinstance(backend, str) or not backend:
                continue
            key = (card_type, backend)
            injected_ids = entry.get("patterns_injected")
            has_pattern = isinstance(injected_ids, list) and pattern["id"] in injected_ids
            groups.setdefault(key, {"injected": [], "control": []})[
                "injected" if has_pattern else "control"].append(entry)
        comparisons, supported = [], []
        for (card_type, backend), group in sorted(groups.items()):
            injected, control = group["injected"], group["control"]
            if len(injected) < 8 or len(control) < 8:
                continue
            exec_injected, n_exec_injected = pattern_rates(injected, "exec_pass")
            exec_control, n_exec_control = pattern_rates(control, "exec_pass")
            accepted_injected, n_accepted_injected = pattern_rates(injected, "accepted")
            accepted_control, n_accepted_control = pattern_rates(control, "accepted")
            if min(n_exec_injected, n_exec_control, n_accepted_injected, n_accepted_control) < 8:
                continue
            comparison = {"card_type": card_type, "backend": backend, "injected_n": len(injected),
                          "control_n": len(control), "exec_pass": [exec_injected, exec_control],
                          "accepted": [accepted_injected, accepted_control]}
            comparisons.append(comparison)
            supported.append(exec_injected <= exec_control and accepted_injected <= accepted_control)
        if not comparisons:
            insufficient += 1
            continue
        if not all(supported):
            continue
        os.makedirs(output_dir, exist_ok=True)
        destination = os.path.join(output_dir, f"retire-{pattern['id']}.md")
        if os.path.exists(destination):
            continue
        lines = ["---", "proposal_type: retire_pattern", f"id: {pattern_yaml_quote(pattern['id'])}",
                 f"title: {pattern_yaml_quote(pattern['title'])}", "status: proposed", "---", "",
                 f"Consider retiring `{pattern['id']}`: injected runs did not outperform similar runs without it.", "",
                 "| Card type | Backend | Injected n | Control n | exec_pass injected/control | accepted injected/control |",
                 "| --- | --- | ---: | ---: | ---: | ---: |"]
        for row in comparisons:
            lines.append(f"| {row['card_type']} | {row['backend']} | {row['injected_n']} | {row['control_n']} | "
                         f"{row['exec_pass'][0]:.3f} / {row['exec_pass'][1]:.3f} | "
                         f"{row['accepted'][0]:.3f} / {row['accepted'][1]:.3f} |")
        lines.append("")
        with open(destination, "x", encoding="utf-8") as stream:
            stream.write("\n".join(lines))
        written.append(destination)
    print(json.dumps({"patterns_checked": checked, "retirement_proposals": written,
                      "insufficient_samples": insufficient}, ensure_ascii=False))


LESSON_ROOT_CAUSE_KEYWORDS = (
    ("secret_exposure", (r"\bsecret", r"\btoken\b", r"credential", r"password", r"private key",
                         r"api key", r"expos(?:e|ed|ure)", r"leak(?:ed|ing)?")),
    ("trust_boundary", (r"trust boundary", r"untrusted", r"user[- ]controlled", r"authorization",
                         r"authentication", r"permission", r"sandbox", r"allowlist", r"access control")),
    ("input_validation", (r"validat", r"sanitize", r"unsanitized", r"schema", r"invalid input",
                           r"input parsing", r"parse untrusted")),
    ("concurrency", (r"concurren", r"race condition", r"race", r"thread.safe", r"deadlock", r"lock",
                      r"atomic write")),
    ("missing_test", (r"missing tests?", r"no tests?", r"test coverage", r"untested", r"regression test")),
    ("i18n_literal", (r"i18n", r"internationali[sz]", r"locali[sz]", r"translation", r"locale",
                       r"hard.coded (?:string|text|copy)", r"literal (?:string|text)")),
    ("platform_assumption", (r"platform assumption", r"platform.specific", r"macos", r"windows", r"linux",
                              r"path separator", r"operating system", r"environment variable")),
    ("error_handling", (r"error handling", r"exception", r"error path", r"failure handling", r"return code",
                         r"timeout", r"retry", r"swallow(?:ed|ing)? errors?")),
)


def lesson_root_cause_class(text):
    value = str(text or "").casefold()
    for name, patterns in LESSON_ROOT_CAUSE_KEYWORDS:
        if any(re.search(pattern, value, re.I) for pattern in patterns):
            return name
    return "other"


def lesson_finding_title(body):
    """Return a short heading from a Codex inline comment, excluding its explanation."""
    for line in str(body or "").splitlines():
        title = lesson_plain_text(line)
        if not title:
            continue
        title = re.sub(r"^#{1,6}\s*", "", title)
        title = re.sub(r"^>\s*", "", title)
        title = title.strip("* `_~")
        if re.fullmatch(r"P[012](?:\s+Badge)?", title, re.I):
            continue
        match = re.match(r"^\[(P[012])\]\s*(.+)$", title, re.I)
        if match:
            title = match.group(2).strip().strip("* `_~")
        else:
            match = re.match(r"^(P[012])(?:\s+Badge)?\s*[:—-]\s*(.+)$", title, re.I)
            if match:
                title = match.group(2).strip().strip("* `_~")
        if title:
            title = re.sub(r"\s+", " ", title).strip()
            return bus_redact(title[:240]).rstrip(" .!?;:")
    return "Review the affected code path"


def lesson_plain_text(value):
    """Remove badge and markdown/HTML decoration before storing a lesson rule."""
    value = html.unescape(str(value or ""))
    value = re.sub(r"!\[([^\]]*)\]\([^)]*\)",
                   lambda match: "" if re.search(r"P[012]\s+Badge", match.group(1), re.I) else match.group(1), value)
    value = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", value)
    value = re.sub(r"<[^>]*>", " ", value)
    value = re.sub(r"(?<!\w)(?:P[012]\s+Badge)(?!\w)", " ", value, flags=re.I)
    value = re.sub(r"\*\*|(?<!\w)__|__(?!\w)|~~|`", "", value)
    value = re.sub(r"\s+", " ", value).strip()
    return value


def lesson_rule_sentence(title):
    title = lesson_plain_text(title)
    # Keep the proposed rule to one sentence even when the review heading contains punctuation.
    title = re.sub(r"[.!?]+(?=\s)", ";", title).rstrip(" .!?;:")
    return bus_redact(f"Prevent recurrence of this finding: {title}.")


def lesson_top_level_paths(entry):
    paths = entry.get("files_changed") or entry.get("area") or []
    if isinstance(paths, str):
        paths = [paths]
    result = set()
    for path in paths if isinstance(paths, list) else []:
        if not isinstance(path, str):
            continue
        normalized = path.strip().replace("\\", "/")
        while normalized.startswith("./"):
            normalized = normalized[2:]
        normalized = normalized.lstrip("/")
        top = normalized.split("/", 1)[0].strip()
        if top and top not in (".", ".."):
            result.add(top)
    return sorted(result)


def lesson_paths_overlap(existing, changed):
    if not existing:
        return True
    if not changed:
        return False
    changed_roots = {path.split("/", 1)[0] for path in changed}
    for pattern in existing:
        value = str(pattern).replace("\\", "/").strip().lstrip("./")
        if not value:
            continue
        root = value.split("/", 1)[0]
        if any(fnmatch.fnmatchcase(path, root) or fnmatch.fnmatchcase(root, path)
               for path in changed_roots):
            return True
    return False


def lesson_existing_records(repo):
    directory = os.path.join(repo, "lessons")
    records = []
    try:
        filenames = sorted(name for name in os.listdir(directory) if name.endswith(".yaml"))
    except FileNotFoundError:
        return records
    except OSError as error:
        raise ValueError(f"cannot read lessons directory {directory}: {error}") from error
    for filename in filenames:
        path = os.path.join(directory, filename)
        try:
            with open(path, encoding="utf-8") as stream:
                lesson = parse_lesson_yaml(stream.read())
        except (OSError, ValueError) as error:
            print(f"openswarm: warning: skipping lesson file {path}: {error}", file=sys.stderr)
            continue
        records.append(lesson)
    return records


def lesson_next_id(repo, existing, seen_comments=None):
    used = set()
    for lesson in existing:
        lesson_id = lesson.get("id")
        if isinstance(lesson_id, str):
            match = re.fullmatch(r"L-(\d+)", lesson_id)
            if match:
                used.add(int(match.group(1)))
    directory = os.path.join(repo, "proposals")
    for path in glob.glob(os.path.join(directory, "**", "*.yaml"), recursive=True):
        try:
            with open(path, encoding="utf-8") as stream:
                match = re.search(r"(?m)^id:\s*['\"]?(L-(\d+))['\"]?\s*$", stream.read())
            if match:
                used.add(int(match.group(2)))
        except OSError:
            continue
    for item in (seen_comments or {}).values():
        if isinstance(item, dict):
            lesson_id = item.get("id") or item.get("lesson_id")
            match = re.fullmatch(r"L-(\d+)", str(lesson_id or ""))
            if match:
                used.add(int(match.group(1)))
    number = 1
    while number in used:
        number += 1
    return number


def lesson_yaml_quote(value):
    return json.dumps(str(value), ensure_ascii=False)


def lesson_proposal_yaml(proposal):
    if proposal["kind"] == "recurrence":
        return (f"proposal_type: recurrence\nlesson_id: {lesson_yaml_quote(proposal['lesson_id'])}\n"
                f"root_cause_class: {lesson_yaml_quote(proposal['root_cause_class'])}\n"
                f"recurrences: {proposal['recurrences']}\nsource: {lesson_yaml_quote(proposal['source'])}\n")
    applies = proposal["applies_to"]
    lines = [f"id: {lesson_yaml_quote(proposal['id'])}", f"date: {lesson_yaml_quote(proposal['date'])}",
             f"title: {lesson_yaml_quote(proposal['title'])}",
             f"root_cause_class: {lesson_yaml_quote(proposal['root_cause_class'])}",
             f"recurrences: {proposal['recurrences']}",
             f"rule: {lesson_yaml_quote(proposal['rule'])}", "guard_level: L2", "applies_to:"]
    for key in ("card_types", "paths", "backends"):
        values = ", ".join(lesson_yaml_quote(value) for value in applies[key])
        lines.append(f"  {key}: [{values}]")
    lines.append(f"source: {lesson_yaml_quote(proposal['source'])}")
    return "\n".join(lines) + "\n"


def lesson_read_comments(entry):
    pr = entry.get("pr") if isinstance(entry.get("pr"), dict) else {}
    repo, number = pr.get("repo"), gh_pr_number(pr)
    if not isinstance(repo, str) or not BUS_REPO_RE.fullmatch(repo) or number is None or number < 1:
        return []
    run_id = str(entry.get("run_id") or entry.get("id") or "__lesson_propose__")
    comments = gh_ingest_pages(run_id, repo, f"repos/{repo}/pulls/{number}/comments")
    findings = []
    for comment in comments:
        if not isinstance(comment, dict):
            continue
        login = str((comment.get("user") or {}).get("login") or "").casefold()
        if login != "chatgpt-codex-connector[bot]":
            continue
        badges = gh_badge_counts(comment.get("body"))
        if not badges.get("p0") and not badges.get("p1"):
            continue
        comment_id = comment.get("id")
        if isinstance(comment_id, bool) or not re.fullmatch(r"[0-9]+", str(comment_id or "")):
            continue
        findings.append((str(comment_id), comment, lesson_finding_title(comment.get("body"))))
    return findings


def lesson_markdown_summary(date, proposals, skipped=0):
    lines = ["# Lesson proposals", "", f"Generated: {date}", "",
             f"Proposals: {len(proposals)}", f"Already seen: {skipped}", ""]
    if not proposals:
        lines.append("No new proposals.")
    for proposal in proposals:
        label = (f"recurrence of `{proposal['lesson_id']}`" if proposal["kind"] == "recurrence"
                 else f"new lesson `{proposal['id']}`")
        lines.append(f"- {label}: `{proposal['root_cause_class']}` — {proposal['title']} ({proposal['source']})")
    return "\n".join(lines) + "\n"


def cmd_lessons_propose(args, policy):
    if not math.isfinite(args.since) or args.since < 0:
        raise ValueError("--since must be a finite non-negative number")
    repo = os.path.expanduser(str((policy.get("knowledge") or {}).get("repo") or DEFAULT_KNOWLEDGE_REPO))
    date = policy_day(policy)[0]
    output_dir = os.path.abspath(os.path.expanduser(args.out)) if args.out else os.path.join(repo, "proposals", date)
    proposals_root = os.path.join(repo, "proposals")
    seen_path = os.path.join(proposals_root, "seen.json")
    ledger_path = fleet_ledger_path() if args.fleet else LEDGER
    threshold = NOW() - args.since * 86400
    def has_priority_findings(entry):
        findings = entry.get("review_findings") if isinstance(entry.get("review_findings"), dict) else {}
        return any(isinstance(findings.get(key), (int, float)) and not isinstance(findings.get(key), bool)
                   and findings.get(key) > 0 for key in ("p0", "p1"))

    entries = [entry for entry in ledger_entries_from(ledger_path)
               if (to_epoch(entry.get("ts")) or 0) >= threshold
               and isinstance(entry.get("pr"), dict) and has_priority_findings(entry)]
    candidates, processed_prs = [], set()
    for entry in entries:
        pr = entry["pr"]
        pr_key = (pr.get("repo"), gh_pr_number(pr))
        if pr_key in processed_prs:
            continue
        processed_prs.add(pr_key)
        findings = lesson_read_comments(entry)
        pr_url = f"https://github.com/{pr['repo']}/pull/{gh_pr_number(pr)}"
        paths = lesson_top_level_paths(entry)
        card_types = [str(entry["card_type"])] if entry.get("card_type") else []
        backends = [str(entry["backend"])] if entry.get("backend") else []
        for comment_id, comment, title in findings:
            body = str(comment.get("body") or "")
            root_class = lesson_root_cause_class(title + "\n" + body)
            source = f"{pr_url}#discussion_r{comment_id}"
            candidates.append({"comment_key": f"{pr['repo']}:{comment_id}", "title": title,
                               "root_cause_class": root_class, "source": bus_redact(source),
                               "paths": paths, "card_types": card_types, "backends": backends})

    lock = None
    if not args.dry_run:
        os.makedirs(proposals_root, exist_ok=True)
        lock = open(seen_path + ".lock", "a", encoding="utf-8")
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        if os.path.isfile(seen_path):
            try:
                with open(seen_path, encoding="utf-8") as stream:
                    seen = json.load(stream)
            except (OSError, ValueError) as error:
                raise ValueError(f"cannot read proposal seen index {seen_path}: {error}") from error
        else:
            seen = {}
        if not isinstance(seen, dict):
            raise ValueError(f"invalid proposal seen index: {seen_path}")
        comment_ids = seen.get("comment_ids", {})
        if isinstance(comment_ids, list):
            comment_ids = {str(value): {} for value in comment_ids}
        if not isinstance(comment_ids, dict):
            raise ValueError(f"invalid proposal comment_ids index: {seen_path}")
        new_candidates = [row for row in candidates if row["comment_key"] not in comment_ids]
        skipped = len(candidates) - len(new_candidates)
        existing = lesson_existing_records(repo)
        next_number = lesson_next_id(repo, existing, comment_ids)
        proposals, file_texts, next_seen = [], {}, dict(comment_ids)
        for candidate in new_candidates:
            matching = [lesson for lesson in existing
                        if lesson.get("root_cause_class") == candidate["root_cause_class"]
                        and lesson_paths_overlap((lesson.get("applies_to") or {}).get("paths") or [],
                                                 candidate["paths"])]
            if matching:
                lesson = sorted(matching, key=lambda item: str(item.get("id")))[0]
                old_recurrences = lesson.get("recurrences", 0)
                recurrences = (old_recurrences if isinstance(old_recurrences, int)
                               and not isinstance(old_recurrences, bool) and old_recurrences >= 0 else 0) + 1
                proposal = {"kind": "recurrence", "lesson_id": lesson["id"],
                            "root_cause_class": candidate["root_cause_class"],
                            "recurrences": recurrences, "title": candidate["title"], "source": candidate["source"]}
                filename = f"recurrence-{lesson['id']}-{candidate['comment_key'].rsplit(':', 1)[-1]}.yaml"
                lesson["recurrences"] = recurrences
            else:
                lesson_id = f"L-{next_number:04d}"
                next_number += 1
                rule = lesson_rule_sentence(candidate["title"])
                proposal = {"kind": "new", "id": lesson_id, "date": date, "title": candidate["title"],
                            "root_cause_class": candidate["root_cause_class"], "recurrences": 1,
                            "rule": rule, "applies_to": {"card_types": candidate["card_types"],
                            "paths": candidate["paths"], "backends": candidate["backends"]},
                            "source": candidate["source"]}
                filename = f"{lesson_id}.yaml"
            proposals.append(proposal)
            file_texts[filename] = lesson_proposal_yaml(proposal)
            next_seen[candidate["comment_key"]] = {
                "source": candidate["source"], "file": filename, "date": date,
                **({"id": proposal["id"]} if proposal["kind"] == "new"
                   else {"lesson_id": proposal["lesson_id"]})}
        summary = lesson_markdown_summary(date, proposals, skipped)
        if args.dry_run:
            for filename, contents in file_texts.items():
                print(f"--- {filename} ---")
                print(contents, end="")
            print(summary, end="")
        else:
            os.makedirs(output_dir, exist_ok=True)
            for filename, contents in file_texts.items():
                path = os.path.join(output_dir, filename)
                fd, temporary = tempfile.mkstemp(prefix=os.path.basename(path) + ".tmp", dir=output_dir)
                try:
                    with os.fdopen(fd, "w", encoding="utf-8") as stream:
                        stream.write(contents)
                        stream.flush()
                        os.fsync(stream.fileno())
                    os.replace(temporary, path)
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
            summary_path = os.path.join(output_dir, "summary.md")
            with open(summary_path, "w", encoding="utf-8") as stream:
                stream.write(summary)
            jsave(seen_path, {**seen, "comment_ids": next_seen})
            print(f"wrote {len(proposals)} lesson proposal(s) to {output_dir}; seen index: {seen_path}")
    finally:
        if lock is not None:
            lock.close()


LESSON_ESCALATION_GUARDS = {
    "secret_exposure": {
        "kind": "openswarm risk rule regex",
        "draft": (r"(?i)(?:api[_-]?key|token|password|secret)\s*[:=]\s*"
                  r"[\"']?[A-Za-z0-9_./+=-]{8,}[\"']?"),
        "message": "Blocked: possible credential in command or patch output.",
        "test": "Add a risk-rule test that blocks a fake credential and allows a safe control string.",
    },
    "trust_boundary": {
        "kind": "verify step",
        "draft": "Before side effects, require an authorization check for the caller and resource.",
        "message": "Reject unauthorized access before performing the protected action.",
        "test": "Add tests proving an unauthorized caller is denied without side effects and an authorized caller succeeds.",
    },
    "input_validation": {
        "kind": "repo lint/GritQL rule",
        "draft": (r"(?i)\b(?:eval|exec|yaml\.load|subprocess\.run)\s*\(\s*"
                  r"(?:request|user|input|payload)\b"),
        "message": "Unvalidated external input reaches a sensitive sink.",
        "test": "Add lint fixtures for an unvalidated external value at a sensitive sink and a validated control case.",
    },
    "concurrency": {
        "kind": "CI check",
        "draft": "Run the regression test with concurrent writers and assert the final state is complete and consistent.",
        "message": "Concurrent updates must not lose or partially publish state.",
        "test": "Add a deterministic concurrent-writer test that fails on lost updates or partial output.",
    },
    "missing_test": {
        "kind": "CI check",
        "draft": "Require a focused regression test whenever a behavior-changing source path is modified.",
        "message": "Behavior changes require a regression test in the same change.",
        "test": "Add a CI fixture with a changed source and no test (must fail), plus a paired test (must pass).",
    },
    "i18n_literal": {
        "kind": "repo lint/GritQL rule",
        "draft": (r"(?i)(?:label|title|placeholder|button_text)\s*=\s*"
                  r"[\"'][^\"']+[\"']"),
        "message": "User-visible text must use the repository's localization helper.",
        "test": "Add lint fixtures for a hard-coded user-visible string and a localized control case.",
    },
    "platform_assumption": {
        "kind": "verify step",
        "draft": "Run the focused verification on ubuntu-latest, macos-latest, and windows-latest.",
        "message": "Platform-sensitive behavior must pass on all supported operating systems.",
        "test": "Add or extend a CI matrix test covering path, environment, and process behavior on each supported OS.",
    },
    "error_handling": {
        "kind": "CI check",
        "draft": "Inject the operation's failure and timeout paths and assert errors are surfaced to the caller.",
        "message": "Failures and timeouts must not be silently swallowed.",
        "test": "Add failure-injection tests for the error and timeout paths, including the expected return code or exception.",
    },
    "other": {
        "kind": "verify step",
        "draft": "Run a focused regression check for the affected lesson rule before merge.",
        "message": "The regression check must fail before the fix and pass after it.",
        "test": "Add a minimal failing-before/fixed-after regression test for this lesson.",
    },
}


def lesson_proposal_field(text, field):
    for line in str(text).splitlines():
        content = lesson_yaml_comment(line).strip()
        match = re.fullmatch(rf"{re.escape(field)}:[ \t]*(.*)", content)
        if match and match.group(1):
            try:
                return lesson_yaml_scalar(match.group(1))
            except ValueError:
                return None
    return None


def lesson_accepted_recurrences(repo):
    """Read accepted recurrence proposals which have not moved into lessons/ yet."""
    result = {}
    directory = os.path.join(repo, "proposals")
    for path in sorted(glob.glob(os.path.join(directory, "**", "*.yaml"), recursive=True)):
        try:
            with open(path, encoding="utf-8") as stream:
                text = stream.read()
        except OSError as error:
            print(f"openswarm: warning: cannot read recurrence proposal {path}: {error}", file=sys.stderr)
            continue
        proposal_type = lesson_proposal_field(text, "proposal_type")
        lesson_id = lesson_proposal_field(text, "lesson_id")
        if proposal_type != "recurrence" or not isinstance(lesson_id, str):
            continue
        accepted_value = lesson_proposal_field(text, "accepted")
        accepted = accepted_value is True or str(accepted_value or "").casefold() in {
            "true", "yes", "accepted", "approved"}
        accepted = accepted or any(
            str(lesson_proposal_field(text, field) or "").casefold() in
            ("accepted", "approved", "accept", "approve")
            for field in ("status", "decision", "state", "review_status", "acceptance"))
        if accepted:
            result.setdefault(lesson_id, []).append({
                "path": path,
                "source": lesson_proposal_field(text, "source"),
            })
    return result


def lesson_evidence_link(label, value, relative=False):
    value = str(value or "").strip()
    if value.startswith(("https://", "http://")):
        target = urllib.parse.quote(value, safe=":/?#[]@!$&'*+,;=%")
        return f"- [{label}]({target})"
    if relative and value:
        target = urllib.parse.quote(value, safe="/.-_")
        return f"- [{label}]({target})"
    return f"- {label}: `{value or 'not recorded'}`"


def lesson_guard_proposal(lesson, lesson_file, recurrence_proposals, recurrences, date, output_dir):
    lesson_id = lesson["id"]
    root_class = lesson.get("root_cause_class") or lesson_root_cause_class(lesson.get("rule"))
    guard = LESSON_ESCALATION_GUARDS.get(root_class, LESSON_ESCALATION_GUARDS["other"])
    applies = lesson.get("applies_to") or {}
    paths = applies.get("paths") or []
    lines = [f"# L3 guard proposal: {lesson_id}", "", f"Generated: {date}", "",
             "## Lesson", "", f"- ID: `{lesson_id}`",
             f"- Guard level: `{lesson.get('guard_level')}` → `L3`",
             f"- Recurrences: `{recurrences}`",
             f"- Root cause class: `{root_class}`",
             f"- Rule: {lesson_plain_text(lesson.get('rule'))}",
             f"- Applies to paths: `{', '.join(paths) if paths else 'all paths'}`", "", "## Evidence", "",
             lesson_evidence_link("Lesson file", os.path.relpath(lesson_file, output_dir), relative=True)]
    source = lesson.get("source")
    if source:
        sources = source if isinstance(source, list) else [source]
        lines.extend(lesson_evidence_link("Lesson source", item) for item in sources)
    else:
        lines.append("- Lesson source: not recorded")
    for proposal in recurrence_proposals:
        relative = os.path.relpath(proposal["path"], output_dir)
        lines.append(lesson_evidence_link("Accepted recurrence proposal", relative, relative=True))
        if proposal.get("source"):
            lines.append(lesson_evidence_link("Recurrence source", proposal["source"]))
    lines.extend(["", "## Proposed guard", "", f"- Kind: **{guard['kind']}**", "",
                  "Draft:", "", "```text", guard["draft"], "```", "",
                  f"Failure message: `{guard['message']}`", "", "## Required accompanying test", "",
                  guard["test"], ""])
    return "\n".join(lines)


def lesson_records_with_paths(repo):
    directory = os.path.join(repo, "lessons")
    records = []
    try:
        filenames = sorted(name for name in os.listdir(directory) if name.endswith(".yaml"))
    except FileNotFoundError:
        return records
    except OSError as error:
        raise ValueError(f"cannot read lessons directory {directory}: {error}") from error
    for filename in filenames:
        path = os.path.join(directory, filename)
        try:
            with open(path, encoding="utf-8") as stream:
                lesson = parse_lesson_yaml(stream.read())
        except (OSError, ValueError) as error:
            print(f"openswarm: warning: skipping lesson file {path}: {error}", file=sys.stderr)
            continue
        records.append((lesson, path))
    return records


def cmd_lessons_escalate(args, policy):
    repo = os.path.expanduser(str((policy.get("knowledge") or {}).get("repo") or DEFAULT_KNOWLEDGE_REPO))
    date = policy_day(policy)[0]
    proposals_root = os.path.join(repo, "proposals")
    output_dir = os.path.abspath(os.path.expanduser(args.out)) if args.out else os.path.join(proposals_root, date)
    seen_path = os.path.join(proposals_root, "escalate-seen.json")
    lock = None
    if not args.dry_run:
        os.makedirs(proposals_root, exist_ok=True)
        lock = open(seen_path + ".lock", "a", encoding="utf-8")
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        if os.path.isfile(seen_path):
            try:
                with open(seen_path, encoding="utf-8") as stream:
                    seen = json.load(stream)
            except (OSError, ValueError) as error:
                raise ValueError(f"cannot read escalation seen index {seen_path}: {error}") from error
        else:
            seen = {}
        if not isinstance(seen, dict):
            raise ValueError(f"invalid escalation seen index: {seen_path}")
        seen_ids = seen.get("lesson_ids", {})
        if isinstance(seen_ids, list):
            seen_ids = {str(value): {} for value in seen_ids}
        if not isinstance(seen_ids, dict):
            raise ValueError(f"invalid escalation lesson_ids index: {seen_path}")

        records = lesson_records_with_paths(repo)
        accepted = lesson_accepted_recurrences(repo)
        proposals, rendered, next_seen = [], {}, dict(seen_ids)
        skipped = 0
        for lesson, lesson_file in records:
            lesson_id = lesson["id"]
            if lesson.get("guard_level") == "L3":
                continue
            base = lesson.get("recurrences", 0)
            base = base if isinstance(base, int) and not isinstance(base, bool) and base >= 0 else 0
            recurrence_proposals = accepted.get(lesson_id, [])
            recurrences = base + len(recurrence_proposals)
            if recurrences < 1:
                continue
            filename = f"guard-{lesson_id}.md"
            if lesson_id in seen_ids or os.path.exists(os.path.join(output_dir, filename)):
                skipped += 1
                next_seen.setdefault(lesson_id, {"file": filename, "date": date})
                continue
            proposal = lesson_guard_proposal(lesson, lesson_file, recurrence_proposals,
                                             recurrences, date, output_dir)
            proposals.append((lesson_id, filename))
            rendered[filename] = proposal
            next_seen[lesson_id] = {"file": filename, "date": date, "recurrences": recurrences}

        if args.dry_run:
            for filename, contents in rendered.items():
                print(f"--- {filename} ---")
                print(contents, end="")
            print(f"Guard proposals: {len(proposals)}; already seen: {skipped}.")
        else:
            os.makedirs(output_dir, exist_ok=True)
            for filename, contents in rendered.items():
                path = os.path.join(output_dir, filename)
                fd, temporary = tempfile.mkstemp(prefix=filename + ".tmp", dir=output_dir)
                try:
                    with os.fdopen(fd, "w", encoding="utf-8") as stream:
                        stream.write(contents)
                        stream.flush()
                        os.fsync(stream.fileno())
                    os.replace(temporary, path)
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
            jsave(seen_path, {**seen, "lesson_ids": next_seen})
            print(f"wrote {len(proposals)} L3 guard proposal(s) to {output_dir}; seen index: {seen_path}")
    finally:
        if lock is not None:
            lock.close()


def source_enabled(policy, name):
    """Opt-in switches for reading other tools' local files (policy.local_sources.<name>)."""
    return bool((policy.get("local_sources") or {}).get(name, False))


def sh(cmd, timeout=60, env=None, cwd=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env,
                           cwd=cwd, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:  # noqa: BLE001
        return 127, "", str(e)


def iso(ts):
    if not ts:
        return None
    return dt.datetime.fromtimestamp(ts).astimezone().isoformat(timespec="minutes")


def to_epoch(v):
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return v / 1000 if v > 1e12 else v
    try:
        return dt.datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def ver_key(s):
    return [int(x) for x in re.findall(r"\d+", s or "")]


def window_stats(used_pct, window_minutes, resets_at):
    """Normalize a rate-limit window: used fraction, pace (>1 = burning faster than even), hours to reset."""
    if used_pct is None:
        return None
    used = float(used_pct) / 100.0
    if resets_at and resets_at < NOW():  # window rolled over since we observed it
        used = 0.0
    out = {"used": round(used, 4), "window_minutes": window_minutes, "resets_at": resets_at,
           "resets_at_local": iso(resets_at), "hours_to_reset": None, "pace": None}
    if resets_at and window_minutes:
        left = max(0.0, resets_at - NOW())
        out["hours_to_reset"] = round(left / 3600, 2)
        elapsed = 1 - left / (window_minutes * 60)
        if elapsed > 0.05:
            out["pace"] = round(used / elapsed, 2)
    return out


# ---------------------------------------------------------------- claude

def probe_claude(policy):
    # Plan resolution, most explicit first: OPENSWARM_CLAUDE_PLAN env -> policy claude.plan ->
    # (opt-in) the plan tier fields of ~/.claude.json. No tokens are read from that file.
    explicit = envvar("CLAUDE_PLAN") or (policy.get("claude") or {}).get("plan")
    oa = {}
    if not explicit and source_enabled(policy, "claude_account_plan"):
        oa = (jload(f"{HOME}/.claude.json", {}) or {}).get("oauthAccount") or {}
    org_type = oa.get("organizationType") or ""
    tier = oa.get("organizationRateLimitTier") or oa.get("userRateLimitTier") or ""
    plan = explicit or "unknown"
    if explicit:
        pass
    elif "max" in org_type or "max" in tier:
        plan = "max-20x" if "20x" in tier else ("max-5x" if "5x" in tier else "max")
    elif "pro" in org_type:
        plan = "pro"
    elif org_type:
        plan = org_type
    provider = os.environ.get("CLAUDE_PROVIDER") or ""
    if not provider:
        cd = os.environ.get("CLAUDE_CONFIG_DIR", "")
        provider = next((p for p in ("ocgo", "deepseek", "minimax") if cd.endswith(p)), "official")
    q = jload(CLAUDE_Q, {}) or {}
    age_min = round((NOW() - q["ts"]) / 60, 1) if q.get("ts") else None
    stale = age_min is None or age_min > policy["thresholds"]["claude_stale_minutes"]
    rl = q.get("rate_limits") or {}

    def win(key, minutes):
        w = rl.get(key) or {}
        pct = w.get("used_percentage", w.get("utilization"))
        return window_stats(pct, minutes, to_epoch(w.get("resets_at"))) if pct is not None else None

    return {
        "plan": plan, "org_type": org_type, "rate_limit_tier": tier,
        "provider": provider, "metered_by_anthropic": provider == "official",
        "five_hour": win("five_hour", 300), "seven_day": win("seven_day", 10080),
        "source": q.get("source"), "age_minutes": age_min, "stale": stale,
    }


def ingest_claude(args):
    if args.five_hour is not None or args.seven_day is not None:
        rl = {}
        if args.five_hour is not None:
            rl["five_hour"] = {"used_percentage": args.five_hour, "resets_at": to_epoch(args.five_hour_resets)}
        if args.seven_day is not None:
            rl["seven_day"] = {"used_percentage": args.seven_day, "resets_at": to_epoch(args.seven_day_resets)}
        src = "manual"
    else:
        payload = json.load(sys.stdin)
        rl = payload.get("rate_limits") or payload.get("plan") or {}
        src = "statusline" if "rate_limits" in payload else "get_usage"
    if not rl:
        return
    jsave(CLAUDE_Q, {"ts": NOW(), "source": src, "rate_limits": rl})
    print(json.dumps({"ok": True, "source": src}))


# ---------------------------------------------------------------- codex

def codex_candidates(policy):
    seen, out = set(), []
    for c in policy["codex"]["binary_candidates"]:
        if c.startswith("$PATH:"):
            paths = [shutil.which(c[6:])]
        else:
            paths = glob.glob(os.path.expanduser(c))
        for p in paths:
            if p and os.path.isfile(p) and os.access(p, os.X_OK):
                rp = os.path.realpath(p)
                if rp not in seen:
                    seen.add(rp)
                    out.append(p)
    return out


def find_codex(policy):
    """Newest codex binary that can actually load the user's config.toml."""
    good = []
    for b in codex_candidates(policy):
        rc, out, _ = sh([b, "--version"], timeout=15)
        if rc != 0:
            continue
        version = out.strip().split()[-1] if out.strip() else "0"
        rc, _, _ = sh([b, "features", "list"], timeout=20, cwd="/tmp")
        if rc == 0:
            good.append((ver_key(version), version, b))
    if not good:
        return None, None
    good.sort(reverse=True)
    return good[0][2], good[0][1]


CODEX_IO_LOST_STREAK = 3


def codex_executor_flags():
    """Disable Computer Use for non-interactive executor runs (shell-only worktrees)."""
    return ["--disable", "computer_use"]


def codex_resolved_binary(policy, lane=None):
    if lane:
        binary = envvar("CODEX_APP_SERVER_BIN") or lane.get("binary") or find_codex(policy)[0]
    else:
        binary = find_codex(policy)[0]
    if binary:
        binary = os.path.realpath(binary)
    return binary


def codex_install_fingerprint(policy, lane=None):
    binary = codex_resolved_binary(policy, lane)
    if not binary:
        return None
    version = None
    if os.path.basename(binary) == "codex":
        rc, out, _ = sh([binary, "--version"], timeout=15)
        if rc == 0 and out.strip():
            version = out.strip().split()[-1]
    try:
        mtime = os.path.getmtime(binary)
    except OSError:
        mtime = None
    return {"binary": binary, "version": version, "mtime": mtime}


def codex_plan(policy):
    """ChatGPT plan behind Codex. Explicit OPENSWARM_CODEX_PLAN / policy codex.plan wins. Decoding the plan claim
    from ~/.codex/auth.json is opt-in (local_sources.codex_auth_plan): only the id_token's
    chatgpt_plan_type claim is decoded locally; the token is never sent anywhere or stored."""
    explicit = envvar("CODEX_PLAN") or (policy.get("codex") or {}).get("plan")
    if explicit:
        return explicit
    if not source_enabled(policy, "codex_auth_plan"):
        return "unknown"
    a = jload(f"{HOME}/.codex/auth.json", {}) or {}
    tok = (a.get("tokens") or {}).get("id_token")
    if not tok:
        return a.get("auth_mode") or "unknown"
    try:
        p = tok.split(".")[1]
        p += "=" * (-len(p) % 4)
        claims = json.loads(base64.urlsafe_b64decode(p))
        return claims.get("https://api.openai.com/auth", {}).get("chatgpt_plan_type") or "unknown"
    except Exception:
        return "unknown"


def classify_codex(desc, policy):
    d = (desc or "").lower()
    kw = policy["codex"]["tier_keywords"]
    for tier in ("deep", "fast", "balanced"):
        if any(k in d for k in kw[tier]):
            return tier
    return "balanced"


def codex_models(binary, policy):
    data = None
    if binary:
        rc, out, _ = sh([binary, "debug", "models"], timeout=30, cwd="/tmp")
        if rc == 0:
            try:
                data = json.loads(out)
            except Exception:
                data = None
    source = "codex debug models"
    if not data:
        data = jload(f"{HOME}/.codex/models_cache.json", {}) or {}
        source = "models_cache.json"
    models = []
    legacy_kw = policy["codex"]["legacy_keywords"]
    for m in data.get("models", []):
        if m.get("visibility") != "list":
            continue
        desc = m.get("description") or ""
        efforts = [x["effort"] for x in m.get("supported_reasoning_levels", [])
                   if x["effort"] not in policy["never_efforts"]]
        models.append({
            "id": m["slug"], "description": desc, "priority": m.get("priority", 99),
            "tier": classify_codex(desc, policy),
            "legacy": any(k in desc.lower() for k in legacy_kw) or bool(m.get("upgrade")),
            "efforts": efforts, "default_effort": m.get("default_reasoning_level"),
            "context_window": m.get("context_window"),
            "limit_id": policy["codex"]["limit_id_by_model"].get(m["slug"], policy["codex"]["default_limit_id"]),
        })
    models.sort(key=lambda x: x["priority"])
    return models, source


def codex_limits(policy):
    """Latest rate_limits per limit_id from recent rollouts (newest first). Only lines containing a
    "rate_limits" payload are parsed; conversation content is ignored. Disable with local_sources.codex_sessions."""
    if not source_enabled(policy, "codex_sessions"):
        return {}
    files = glob.glob(f"{HOME}/.codex/sessions/*/*/*/rollout-*.jsonl")
    files.sort(key=lambda f: os.path.getmtime(f), reverse=True)
    found, newest_ts = {}, None
    for f in files[:40]:
        try:
            size = os.path.getsize(f)
            with open(f, "rb") as fh:
                fh.seek(max(0, size - 400_000))
                lines = fh.read().decode("utf-8", "ignore").splitlines()
        except Exception:
            continue
        for line in reversed(lines):
            if '"rate_limits"' not in line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            rl = (ev.get("payload") or {}).get("rate_limits")
            if not rl:
                continue
            lid = rl.get("limit_id") or "codex"
            if lid in found:
                continue
            ts = to_epoch(ev.get("timestamp"))
            newest_ts = max(newest_ts or 0, ts or 0)
            wins = {}
            for k in ("primary", "secondary"):
                w = rl.get(k)
                if w:
                    name = "five_hour" if w.get("window_minutes") == 300 else (
                        "seven_day" if w.get("window_minutes") == 10080 else f"w{w.get('window_minutes')}")
                    wins[name] = window_stats(w.get("used_percent"), w.get("window_minutes"), w.get("resets_at"))
            found[lid] = {"name": rl.get("limit_name"), "windows": wins, "observed_at": iso(ts),
                          "age_minutes": round((NOW() - ts) / 60, 1) if ts else None,
                          "credits": rl.get("credits"), "reached": rl.get("rate_limit_reached_type")}
        if "codex" in found and len(found) >= 2:
            break
    return found


def probe_codex(policy):
    binary, version = find_codex(policy)
    models, source = codex_models(binary, policy)
    return {"binary": binary, "version": version, "plan": codex_plan(policy), "models": models,
            "models_source": source, "limits": codex_limits(policy), "config_model": codex_config_model()}


def codex_config_model():
    """Top-level default `model` in ~/.codex/config.toml (used by bare `codex exec`)."""
    try:
        for line in open(f"{HOME}/.codex/config.toml"):
            if line.lstrip().startswith("["):
                break
            m = re.match(r'\s*model\s*=\s*"([^"]+)"', line)
            if m:
                return m.group(1)
    except OSError:
        pass
    return None


# ---------------------------------------------------------------- opencode (ocgo + deepseek)

def opencode_bin():
    # Prefer the real binary over shell wrappers; OPENSWARM_OPENCODE_BIN overrides.
    env_bin = envvar("OPENCODE_BIN")
    if env_bin and os.access(env_bin, os.X_OK):
        return env_bin
    for p in ("/opt/homebrew/bin/opencode", "/usr/local/bin/opencode"):
        if os.access(p, os.X_OK):
            return p
    w = shutil.which("opencode")
    return w


def opencode_env():
    env = dict(os.environ)
    env["OPENCODE_SKIP_STARTUP"] = "1"
    env["OPENCODE_CONFIG_DIR"] = f"{HOME}/.config/opencode"
    return env


def opencode_models(provider):
    ob = opencode_bin()
    if not ob:
        return []
    rc, out, _ = sh([ob, "models", provider, "--verbose", "--pure"], timeout=60, env=opencode_env())
    if rc != 0:
        return []
    models, buf, cur = [], [], None

    def flush():
        if cur and buf:
            try:
                models.append(json.loads("\n".join(buf)))
            except Exception:
                pass

    for line in out.splitlines():
        if re.match(rf"^{re.escape(provider)}/\S+$", line.strip()):
            flush()
            cur, buf = line.strip(), []
        elif cur is not None:
            buf.append(line)
    flush()
    return models


def ocgo_spend(policy):
    """Per-model opencode-go spend over rolling 5h / 7d / 30d windows from opencode's local DB (read-only;
    only model id, role and cost columns). Disable with local_sources.opencode_db."""
    out = {}
    if not source_enabled(policy, "opencode_db") or not os.path.exists(OPENCODE_DB):
        return out
    try:
        con = sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True, timeout=5)
        now_ms = int(NOW() * 1000)
        for key, secs in (("5h", 5 * 3600), ("7d", 7 * 86400), ("30d", 30 * 86400)):
            rows = con.execute(
                "select json_extract(data,'$.modelID'), sum(json_extract(data,'$.cost')) from message "
                "where json_extract(data,'$.providerID')='opencode-go' and json_extract(data,'$.role')='assistant' "
                "and time_created > ? group by 1", (now_ms - secs * 1000,)).fetchall()
            for mid, cost in rows:
                out.setdefault(mid, {"5h": 0.0, "7d": 0.0, "30d": 0.0})[key] = round(cost or 0.0, 4)
        con.close()
    except Exception as e:  # noqa: BLE001
        out["_error"] = str(e)
    return out


def probe_ocgo(policy):
    cfg = policy["ocgo"]
    raw = opencode_models("opencode-go")
    spend = ocgo_spend(policy)
    limits_tbl = cfg["monthly_limits"]
    plan = cfg["plan"]
    if plan == "auto":
        plan = "go"
        for mid, s in spend.items():
            if mid.startswith("_"):
                continue
            if s["30d"] > limits_tbl["go"].get(mid, limits_tbl["go"]["_default"]) * 1.02:
                plan = "plus"  # spent more than Go allows without being cut off
        for e in recent_ledger(500):
            if e.get("backend") == "ocgo" and e.get("error_class") == "rate_limit" and plan == "go":
                pass  # consistent with Go; keep
    limits = limits_tbl[plan]
    excl = cfg["exclude_patterns"]
    models = []
    for m in raw:
        mid = m.get("id", "")
        caps = m.get("capabilities") or {}
        excluded = any(p in mid for p in excl) or not caps.get("toolcall") or m.get("status") not in (None, "active")
        cost = m.get("cost") or {}
        monthly = limits.get(mid, limits["_default"])
        s = spend.get(mid, {"5h": 0.0, "7d": 0.0, "30d": 0.0})
        wf = cfg["window_fractions"]
        usage = {w: round(s[w] / (monthly * wf[w]), 4) if monthly else 0 for w in ("5h", "7d", "30d")}
        models.append({
            "id": mid, "name": m.get("name"), "family": m.get("family"), "release_date": m.get("release_date"),
            "cost_in": cost.get("input"), "cost_out": cost.get("output"),
            "context": (m.get("limit") or {}).get("context"),
            "variants": list((m.get("variants") or {}).keys()), "reasoning": caps.get("reasoning"),
            "monthly_limit_usd": monthly, "spend_usd": s, "usage": usage,
            "excluded": excluded,
        })
    # Tier by output price among usable models (price is the best available proxy for capability).
    usable = sorted([m for m in models if not m["excluded"] and m["cost_out"] is not None], key=lambda m: m["cost_out"])
    n = len(usable)
    for i, m in enumerate(usable):
        m["tier"] = "fast" if i < n / 3 else ("balanced" if i < 2 * n / 3 else "deep")
    for m in models:
        m.setdefault("tier", None)
    return {"binary": opencode_bin(), "plan": plan, "plan_inferred": cfg["plan"] == "auto",
            "limits_source": cfg["monthly_limits_source"], "models": models,
            "spend_note": "only opencode-run usage is visible locally; traffic outside `opencode run` is not counted"}


def keychain(item):
    """macOS Keychain lookup for an item YOU created for openswarm (see README). No-op elsewhere."""
    if sys.platform != "darwin" or not shutil.which("security"):
        return None
    for flag in ("-s", "-a"):
        rc, out, _ = sh(["security", "find-generic-password", flag, item, "-w"], timeout=10)
        if rc == 0 and out.strip():
            return out.strip()
    return None


def probe_deepseek(policy):
    # DEEPSEEK_API_KEY env wins; otherwise only the Keychain items you list in deepseek.keychain_items (default none).
    key = os.environ.get("DEEPSEEK_API_KEY") or next(
        (k for k in (keychain(i) for i in policy["deepseek"].get("keychain_items") or []) if k), None)
    res = {"plan": "pay-as-you-go", "balance": None, "currency": None, "available": None, "api_models": [],
           "opencode_models": [m.get("id") for m in opencode_models("deepseek")]}
    if not key:
        res["error"] = "no api key"
        return res
    hdr = {"Authorization": f"Bearer {key}", "Accept": "application/json"}
    try:
        req = urllib.request.Request("https://api.deepseek.com/user/balance", headers=hdr)
        d = json.load(urllib.request.urlopen(req, timeout=15))
        res["available"] = d.get("is_available")
        bi = (d.get("balance_infos") or [{}])[0]
        res["balance"], res["currency"] = float(bi.get("total_balance", 0)), bi.get("currency")
        req = urllib.request.Request("https://api.deepseek.com/models", headers=hdr)
        res["api_models"] = [m["id"] for m in json.load(urllib.request.urlopen(req, timeout=15)).get("data", [])]
    except Exception as e:  # noqa: BLE001
        res["error"] = str(e)[:200]
    return res


# ---------------------------------------------------------------- state

def probe(policy, quiet=False):
    state = {"generated_at": NOW(), "generated_at_local": iso(NOW()),
             "claude": probe_claude(policy), "codex": probe_codex(policy),
             "ocgo": probe_ocgo(policy), "deepseek": probe_deepseek(policy),
             "cursor": probe_cursor(policy), "agy": probe_agy(policy), "pi": probe_pi(policy)}
    jsave(STATE, state)
    return state


def get_state(policy, refresh=False):
    fixed = envvar("STATE_FILE")
    if fixed:  # offline mode: route/status against a saved or synthetic state (demos, tests, CI)
        st = jload(fixed)
        if not st:
            sys.exit(f"openswarm: cannot read OPENSWARM_STATE_FILE={fixed}")
        return st
    st = jload(STATE)
    ttl = policy["thresholds"]["state_ttl_minutes"] * 60
    if refresh or not st or NOW() - st.get("generated_at", 0) > ttl:
        st = probe(policy)
    return st


def breakers():
    b = jload(BREAKERS, {}) or {}
    return {k: v for k, v in b.items() if v > NOW()}


def trip_breaker(key, policy, reason):
    b = breakers()
    b[key] = NOW() + policy["thresholds"]["breaker_minutes"] * 60
    jsave(BREAKERS, b)


def recent_ledger(n=50, path=None):
    try:
        with open(path or LEDGER) as f:
            lines = f.readlines()[-n:]
        return [json.loads(x) for x in lines if x.strip()]
    except Exception:
        return []


# ---------------------------------------------------------------- routing

def ledger_entries():
    try:
        with open(LEDGER) as stream:
            for line in stream:
                try:
                    entry = json.loads(line)
                    if isinstance(entry, dict):
                        yield entry
                except ValueError:
                    continue
    except FileNotFoundError:
        return


def routing_min_samples(policy):
    value = (policy.get("routing") or {}).get("min_samples", 8)
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise ValueError("routing.min_samples must be a positive integer")
    return value


def routing_median(values):
    values = sorted(values)
    if not values:
        return None
    middle = len(values) // 2
    if len(values) % 2:
        return values[middle]
    return (values[middle - 1] + values[middle]) / 2


def routing_tokens(entry):
    tokens = entry.get("tokens")
    if isinstance(tokens, dict):
        total = tokens.get("total")
        if isinstance(total, (int, float)) and math.isfinite(total) and total >= 0:
            return total
    usage = entry.get("usage")
    if isinstance(usage, dict):
        total = usage.get("total", usage.get("total_tokens"))
        if isinstance(total, (int, float)) and math.isfinite(total) and total >= 0:
            return total
        inputs = usage.get("input", usage.get("input_tokens", usage.get("prompt_tokens")))
        outputs = usage.get("output", usage.get("output_tokens", usage.get("completion_tokens")))
        if all(isinstance(value, (int, float)) and math.isfinite(value) and value >= 0
               for value in (inputs, outputs)):
            return inputs + outputs
    return None


def routing_outcome(entry):
    accepted = entry.get("accepted")
    if isinstance(accepted, bool):
        return accepted
    exec_pass = entry.get("exec_pass")
    return exec_pass if isinstance(exec_pass, bool) else None


def routing_passed(entry):
    return routing_outcome(entry) is True


def compute_routing_weights(entries, min_samples=8):
    groups = {}
    for entry in entries:
        if not isinstance(entry, dict) or not entry.get("backend"):
            continue
        key = (entry.get("backend"), entry.get("model"), entry.get("card_type"))
        groups.setdefault(key, []).append(entry)

    rows = []
    for (backend, model, card_type), runs in sorted(
            groups.items(), key=lambda item: tuple((value is not None, str(value).casefold(), str(value))
                                                   for value in item[0])):
        reviewed = []
        peer_reviewed = []
        for entry in runs:
            findings = entry.get("review_findings")
            if isinstance(findings, dict):
                p0 = findings.get("p0", 0)
                p1 = findings.get("p1", 0)
                reviewed.append(bool((isinstance(p0, (int, float)) and p0 > 0) or
                                     (isinstance(p1, (int, float)) and p1 > 0)))
            peer = entry.get("peer_review")
            if isinstance(peer, dict) and all(isinstance(peer.get(key), (int, float))
                                              and not isinstance(peer.get(key), bool)
                                              and peer.get(key) >= 0 for key in ("p0", "p1", "p2")):
                peer_reviewed.append(bool(peer.get("p0", 0) > 0 or peer.get("p1", 0) > 0))
        attempt_counts = [len(value) if isinstance(value, list) else 0
                          for value in (entry.get("attempts") for entry in runs)]
        seconds = [value for value in (entry.get("seconds") for entry in runs)
                   if isinstance(value, (int, float)) and math.isfinite(value) and value >= 0]
        tokens = [value for value in (routing_tokens(entry) for entry in runs) if value is not None]
        accepted_values = [entry["accepted"] for entry in runs if isinstance(entry.get("accepted"), bool)]
        exec_pass_values = [entry["exec_pass"] for entry in runs if isinstance(entry.get("exec_pass"), bool)]
        exec_pass_passes = sum(exec_pass_values)
        outcomes = [outcome for outcome in (routing_outcome(entry) for entry in runs) if outcome is not None]
        rows.append({
            "backend": backend,
            "model": model,
            "card_type": card_type,
            "runs": len(runs),
            "scored_runs": len(outcomes),
            "pass_rate": sum(outcomes) / len(outcomes) if outcomes else None,
            "accepted_runs": len(accepted_values),
            "accepted_rate": sum(accepted_values) / len(accepted_values) if accepted_values else None,
            "exec_pass_runs": len(exec_pass_values),
            "exec_pass_rate": exec_pass_passes / len(exec_pass_values) if exec_pass_values else None,
            "exec_pass_ratio": f"{exec_pass_passes}/{len(exec_pass_values)}",
            "exec_pass_null_runs": len(runs) - len(exec_pass_values),
            "first_try_rate": sum(count == 1 for count in attempt_counts) / len(runs),
            "rework_rate": sum(bool(entry.get("rework_of")) for entry in runs) / len(runs),
            "review_p1_rate": sum(reviewed) / len(reviewed) if reviewed else None,
            "peer_reviewed_runs": len(peer_reviewed),
            "peer_review_p1_rate": sum(peer_reviewed) / len(peer_reviewed) if peer_reviewed else None,
            "median_tokens": routing_median(tokens),
            "median_seconds": routing_median(seconds),
            "enough": len(outcomes) >= min_samples,
        })
    return {"min_samples": min_samples, "entries": rows}


def routing_weights_path(policy):
    repo = os.path.expanduser(str((policy.get("knowledge") or {}).get("repo") or DEFAULT_KNOWLEDGE_REPO))
    return os.path.join(repo, "routing", "weights.json")


def ledger_entries_from(path):
    try:
        with open(path, encoding="utf-8") as stream:
            for line in stream:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if isinstance(entry, dict):
                    yield entry
    except FileNotFoundError:
        return


def routing_advice(profile, card_type, st, policy, actual_decision):
    """Return record-only advice from enough-sample groups eligible for this live state."""
    if profile.get("backend") or not actual_decision.get("ok"):
        return None
    weights = compute_routing_weights(ledger_entries(), routing_min_samples(policy))
    candidates = []
    possible = list(dict.fromkeys([actual_decision.get("backend")] +
                                  (actual_decision.get("fallbacks") or [])))
    for backend in possible:
        if not backend:
            continue
        planner = PLANNERS.get(backend)
        eligible, _ = planner({**profile, "backend": backend}, st, policy, True, []) if planner else (None, None)
        if not eligible:
            continue
        for row in weights["entries"]:
            if row["backend"] != backend or row["card_type"] != card_type or not row["enough"]:
                continue
            if profile.get("model") and row["model"] != profile["model"]:
                continue
            quality = (row["pass_rate"] if row["pass_rate"] is not None else 0,
                       row["first_try_rate"], -row["rework_rate"],
                       -max(row["review_p1_rate"] or 0, row["peer_review_p1_rate"] or 0))
            cost = (row["median_tokens"] if row["median_tokens"] is not None else math.inf,
                    row["median_seconds"] if row["median_seconds"] is not None else math.inf)
            candidates.append((quality, cost, row))
    if not candidates:
        return {"backend": None, "model": None,
                "reason": f"no eligible {card_type or 'untyped'} routing samples meet min_samples="
                          f"{weights['min_samples']}"}
    candidates.sort(key=lambda item: (-item[0][0], -item[0][1], -item[0][2], -item[0][3],
                                     item[1][0], item[1][1], item[2]["backend"],
                                     str(item[2]["model"] or "")))
    row = candidates[0][2]
    return {"backend": row["backend"], "model": row["model"],
            "reason": (f"best observed pass, first-try, rework, and P1+ rates among {row['runs']} "
                       "eligible samples; ties use median tokens then seconds; actual routing unchanged")}


def cmd_routing_weights(args, policy):
    path = fleet_ledger_path() if args.fleet else LEDGER
    weights = compute_routing_weights(ledger_entries_from(path), routing_min_samples(policy))
    output_path = os.path.expanduser(args.out) if args.out else routing_weights_path(policy)
    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as stream:
        json.dump(weights, stream, ensure_ascii=False, indent=2, sort_keys=True)
        stream.write("\n")
    print(json.dumps({"path": output_path, **weights}, ensure_ascii=False, indent=2, sort_keys=True))


def outcome_label(entry):
    outcome = routing_outcome(entry)
    return ("pass" if outcome else f"fail/{entry.get('status') or 'unknown'}") if outcome is not None else "unknown"


def cmd_routing_compare(args, policy):
    if args.days < 0:
        raise ValueError("--days must be non-negative")
    cutoff = NOW() - args.days * 86400
    path = fleet_ledger_path() if getattr(args, "fleet", False) else LEDGER
    entries = [entry for entry in ledger_entries_from(path)
               if (to_epoch(entry.get("ts")) or 0) >= cutoff and isinstance(entry.get("routing_advice"), dict)]
    print(f"{'date':<20} {'card_type':<16} {'advice':<28} {'advice outcome':<16} {'actual':<28} actual outcome")
    print("-" * 126)
    for entry in sorted(entries, key=lambda row: (to_epoch(row.get("ts")) or 0, str(row.get("id") or "")),
                        reverse=True):
        advice = entry["routing_advice"]
        advised = f"{advice.get('backend') or '-'} / {advice.get('model') or '-'}"
        actual_backend, actual_model = entry.get("backend") or "-", entry.get("model") or "-"
        actual = f"{actual_backend} / {actual_model}"
        advice_outcome = outcome_label(entry) if (advice.get("backend"), advice.get("model")) == (
            actual_backend, actual_model) else "not run"
        ts = to_epoch(entry.get("ts")) or 0
        date = dt.datetime.fromtimestamp(ts).astimezone().strftime("%Y-%m-%d %H:%M") if ts else "unknown"
        print(f"{date:<20} {(entry.get('card_type') or '-'):<16} {advised:<28} {advice_outcome:<16} "
              f"{actual:<28} {outcome_label(entry)}")


# ---------------------------------------------------------------- weekly retro

def retro_safe(value, limit=240):
    text = bus_redact(str(value or "-")).replace("\r", " ").replace("\n", " ")
    text = text.replace("\\", "\\\\").replace("`", "\\`").replace("|", "\\|")
    text = text.replace("<", "&lt;").replace(">", "&gt;").replace("[", "\\[").replace("]", "\\]")
    return text[:limit]


def retro_ratio(entries, field):
    values = [entry[field] for entry in entries if isinstance(entry.get(field), bool)]
    if not values:
        return "— (0/0)"
    passed = sum(values)
    return f"{passed}/{len(values)} ({passed / len(values):.0%})"


def retro_peer_review_p1_ratio(entries):
    reviewed = [entry.get("peer_review") for entry in entries
                if isinstance(entry.get("peer_review"), dict)
                and all(isinstance(entry["peer_review"].get(key), (int, float))
                        and not isinstance(entry["peer_review"].get(key), bool)
                        and entry["peer_review"].get(key) >= 0 for key in ("p0", "p1", "p2"))]
    if not reviewed:
        return "— (0/0)"
    priority = sum(review.get("p0", 0) > 0 or review.get("p1", 0) > 0 for review in reviewed)
    return f"{priority}/{len(reviewed)} ({priority / len(reviewed):.0%})"


def retro_exec_pass_ratio(entries):
    values = [entry["exec_pass"] for entry in entries if isinstance(entry.get("exec_pass"), bool)]
    passed = sum(values)
    rate = f" ({passed / len(values):.0%})" if values else ""
    return f"{passed}/{len(values)}{rate}; null={len(entries) - len(values)}"


def retro_groups(entries):
    groups = {}
    for entry in entries:
        key = (str(entry.get("backend") or "unknown"), str(entry.get("model") or "unknown"),
               str(entry.get("card_type") or "unknown"))
        groups.setdefault(key, []).append(entry)
    return [(key, groups[key]) for key in sorted(groups, key=lambda item: tuple(value.casefold() for value in item))]


def retro_failure_counts(entries):
    counts = {}
    for entry in entries:
        if not retro_is_failure(entry):
            continue
        error_class = entry.get("error_class")
        if not error_class:
            attempts = entry.get("attempts")
            if isinstance(attempts, list):
                error_class = next((attempt.get("error_class") for attempt in reversed(attempts)
                                   if isinstance(attempt, dict) and attempt.get("error_class")), None)
        if error_class:
            name = retro_safe(error_class)
            counts[name] = counts.get(name, 0) + 1
    return sorted(counts.items(), key=lambda item: (-item[1], item[0].casefold()))


def retro_is_failure(entry):
    return entry.get("exec_pass") is False or entry.get("status") in ("failed", "rejected")


def retro_rejected(entries):
    return [entry for entry in entries if entry.get("accepted") is False or entry.get("status") == "rejected"]


def retro_routing_rows(entries, cutoff, end=None):
    rows = [entry for entry in entries if (to_epoch(entry.get("ts")) or 0) >= cutoff
            and (end is None or (to_epoch(entry.get("ts")) or 0) <= end)
            and isinstance(entry.get("routing_advice"), dict)]
    output = []
    for entry in sorted(rows, key=lambda row: (to_epoch(row.get("ts")) or 0,
                                                str(row.get("run_id") or row.get("id") or "")), reverse=True):
        advice = entry["routing_advice"]
        advised = (advice.get("backend") or "-", advice.get("model") or "-")
        actual = (entry.get("backend") or "-", entry.get("model") or "-")
        advice_outcome = outcome_label(entry) if advised == actual else "not run"
        timestamp = to_epoch(entry.get("ts")) or 0
        date = dt.datetime.fromtimestamp(timestamp).astimezone().strftime("%Y-%m-%d %H:%M") if timestamp else "unknown"
        output.append((date, entry.get("card_type") or "-", advised, advice_outcome, actual,
                       outcome_label(entry), advised != actual, entry))
    return output


def retro_snapshot_proposals(repo):
    snapshot = {}
    for directory, subdirs, files in os.walk(repo):
        subdirs[:] = [name for name in subdirs if name != ".git"]
        for name in files:
            path = os.path.join(directory, name)
            relative = os.path.relpath(path, repo).replace(os.sep, "/")
            if "proposal" not in relative.casefold() and "guard" not in relative.casefold():
                continue
            try:
                stat = os.stat(path)
            except OSError:
                continue
            snapshot[relative] = (stat.st_mtime_ns, stat.st_size)
    return snapshot


def retro_proposal_changes(before, after):
    changed = [path for path, signature in after.items() if before.get(path) != signature]
    lessons = [path for path in changed if "guard" not in path.casefold()
               and path.casefold().endswith((".yaml", ".yml"))]
    guards = [path for path in changed if "guard" in path.casefold()]
    return lessons, guards


def retro_step(name, args, policy):
    """Run one existing command implementation so tests can stub the pipeline."""
    if name == "fleet ledger pull":
        cmd_fleet_ledger_pull(args)
    elif name == "ledger ingest":
        cmd_ledger_ingest(args)
    elif name == "ledger backfill-pass":
        cmd_ledger_backfill_pass(args)
    elif name == "routing weights":
        cmd_routing_weights(args, policy)
    elif name == "routing compare":
        cmd_routing_compare(args, policy)
    elif name == "lessons propose":
        cmd_lessons_propose(args, policy)
    elif name == "lessons escalate":
        handler = globals().get("cmd_lessons_escalate")
        if not callable(handler):
            return False
        result = subprocess.run([sys.executable, os.path.realpath(__file__), "lessons", "escalate"],
                                capture_output=True, text=True)
        if result.returncode:
            detail = bus_redact((result.stderr or "").strip())
            raise RuntimeError(f"lessons escalate failed (rc={result.returncode})"
                               + (f": {detail}" if detail else ""))
        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
    else:
        raise ValueError(f"unknown retro step: {name}")
    return True


def retro_capture_step(name, args, policy):
    output, error = io.StringIO(), io.StringIO()
    try:
        with contextlib.redirect_stdout(output), contextlib.redirect_stderr(error):
            completed = retro_step(name, args, policy)
    except BusError as exc:
        if name == "ledger ingest" and gh_ingest_is_rate_limited(exc):
            return {"ok": False, "rate_limited": True, "output": output.getvalue(),
                    "error": error.getvalue() + str(exc)}
        raise
    return {"ok": True, "skipped": completed is False, "output": output.getvalue(), "error": error.getvalue()}


def retro_report_text(entries, start, end, days, policy, notes, lesson_paths, guard_paths, compare_rows):
    groups = retro_groups(entries)
    failures = retro_failure_counts(entries)
    rejected = retro_rejected(entries)
    lines = ["# Weekly retrospective", "", f"Window: {start} to {end} ({days} days)", "",
             "## Runs by backend/model/card_type", "",
             "| Backend | Model | Card type | Runs | exec_pass | accepted | peer review P1+ |",
             "| --- | --- | --- | ---: | ---: | ---: | ---: |"]
    if groups:
        for (backend, model, card_type), runs in groups:
            lines.append(f"| {retro_safe(backend)} | {retro_safe(model)} | {retro_safe(card_type)} | {len(runs)} "
                         f"| {retro_exec_pass_ratio(runs)} | {retro_ratio(runs, 'accepted')} "
                         f"| {retro_peer_review_p1_ratio(runs)} |")
    else:
        lines.append("| — | — | — | 0 | — (0/0); null=0 | — (0/0) | — (0/0) |")

    lines.extend(["", "## Top failure error_classes", "", "| error_class | Runs |", "| --- | ---: |"])
    lines.extend([f"| {retro_safe(name)} | {count} |" for name, count in failures] or ["| None recorded | 0 |"])

    lines.extend(["", "## Rejected runs", "", "| Run | Date | Backend | Card type | Reason | Evidence |",
                  "| --- | --- | --- | --- | --- | --- |"])
    for entry in rejected:
        timestamp = to_epoch(entry.get("ts")) or 0
        date = dt.datetime.fromtimestamp(timestamp).astimezone().strftime("%Y-%m-%d") if timestamp else "unknown"
        run_id = retro_safe(entry.get("run_id") or entry.get("id"))
        reason = (entry.get("accepted_reason") or entry.get("rejection_reason") or entry.get("reason")
                  or entry.get("error") or "No rejection reason recorded")
        lines.append(f"| `{run_id}` | {date} | {retro_safe(entry.get('backend'))} | "
                     f"{retro_safe(entry.get('card_type'))} | {retro_safe(reason)} | [ledger run](#rejected-runs) |")
    if not rejected:
        lines.append("| — | — | — | — | None recorded | — |")

    lines.extend(["", "## New lesson and guard proposals", "", "| Type | Proposal | Link |",
                  "| --- | --- | --- |"])
    proposals = [("Lesson", path) for path in lesson_paths] + [("Guard", path) for path in guard_paths]
    # The final relative links are recomputed by cmd_retro for --out destinations.
    for kind, path in proposals:
        lines.append(f"| {kind} | `{retro_safe(os.path.basename(path))}` | `{retro_safe(path)}` |")
    if not proposals:
        lines.append("| — | No new proposals | — |")

    lines.extend(["", "## Routing advice vs actual (`routing compare --days`)", "",
                  "| Date | Card type | Advice | Advice outcome | Actual | Actual outcome |",
                  "| --- | --- | --- | --- | --- | --- |"])
    for date, card_type, advised, advice_outcome, actual, actual_outcome, _, _ in compare_rows:
        lines.append(f"| {retro_safe(date)} | {retro_safe(card_type)} | "
                     f"{retro_safe(advised[0])} / {retro_safe(advised[1])} | {retro_safe(advice_outcome)} | "
                     f"{retro_safe(actual[0])} / {retro_safe(actual[1])} | {retro_safe(actual_outcome)} |")
    if not compare_rows:
        lines.append("| — | — | — | — | — | No routing advice recorded |")

    lines.extend(["", "## Proposed changes", ""])
    proposed = []
    if failures:
        proposed.append(f"Investigate `{retro_safe(failures[0][0])}` failures ({failures[0][1]} runs) [failure evidence](#top-failure-error_classes).")
    if rejected:
        proposed.append(f"Review {len(rejected)} rejected run(s) and recorded reasons [rejection evidence](#rejected-runs).")
    if len(proposals) <= 3:
        for kind, path in proposals:
            proposed.append(f"Review the {kind.lower()} proposal `{retro_safe(os.path.basename(path))}` [proposal evidence](#new-lesson-and-guard-proposals).")
    elif proposals:
        proposed.append(f"Review {len(proposals)} new lesson and guard proposals [proposal evidence](#new-lesson-and-guard-proposals).")
    routing_mismatches = {}
    for row in compare_rows:
        if row[6]:
            pair = (row[2], row[4])
            routing_mismatches[pair] = routing_mismatches.get(pair, 0) + 1
    for (advised, actual), count in sorted(routing_mismatches.items(), key=lambda item: (-item[1], item[0]))[:3]:
        proposed.append(f"Review routing advice `{retro_safe(advised[0])} / {retro_safe(advised[1])}` against actual "
                        f"`{retro_safe(actual[0])} / {retro_safe(actual[1])}` ({count} runs) "
                        "[routing evidence](#routing-advice-vs-actual-routing-compare-days).")
    if len(routing_mismatches) > 3:
        proposed.append(f"Review {len(routing_mismatches) - 3} additional routing mismatch group(s) "
                        "[routing evidence](#routing-advice-vs-actual-routing-compare-days).")
    lines.extend(proposed or ["No changes proposed from this window's recorded evidence [run summary](#runs-by-backend-model-card_type)."])
    lines.extend(["", "## Run notes", ""])
    lines.extend([f"- {retro_safe(note)}" for note in notes] or ["- All available retro steps completed."])
    return "\n".join(lines) + "\n"


def cmd_retro(args, policy):
    if args.days < 0:
        raise ValueError("--days must be non-negative")
    configured_repo = (policy.get("knowledge") or {}).get("repo")
    repo = os.path.abspath(os.path.expanduser(str(configured_repo or DEFAULT_KNOWLEDGE_REPO)))
    if not os.path.isdir(repo):
        raise ValueError(f"knowledge repo not found: {repo}")
    output_dir = os.path.abspath(os.path.expanduser(args.out)) if args.out else os.path.join(repo, "retro")
    os.makedirs(output_dir, exist_ok=True)

    now = NOW()
    cutoff = now - args.days * 86400
    zone_name = (policy.get("budget") or {}).get("timezone") or policy.get("timezone")
    zone = ZoneInfo(zone_name) if zone_name else dt.datetime.now().astimezone().tzinfo
    start = dt.datetime.fromtimestamp(cutoff, zone).isoformat(timespec="seconds")
    end = dt.datetime.fromtimestamp(now, zone).isoformat(timespec="seconds")
    today = dt.datetime.fromtimestamp(now, zone).date()
    iso_year, iso_week, _ = today.isocalendar()
    report_path = os.path.join(output_dir, f"{iso_year}-W{iso_week:02d}.md")
    proposal_snapshot = retro_snapshot_proposals(repo)
    notes = []
    steps = {}

    if not args.no_pull:
        steps["fleet ledger pull"] = retro_capture_step("fleet ledger pull",
                                                         argparse.Namespace(hosts=None, into=None), policy)
    else:
        notes.append("Skipped fleet ledger pull (--no-pull).")

    steps["ledger ingest"] = retro_capture_step("ledger ingest",
                                                 argparse.Namespace(repo=args.repos or [], since=args.days,
                                                                    refresh=False), policy)
    if steps["ledger ingest"].get("rate_limited"):
        notes.append("Ledger ingest hit the GitHub rate limit; saved progress is included and retro continued.")
    steps["ledger backfill-pass"] = retro_capture_step("ledger backfill-pass",
                                                        argparse.Namespace(fleet=True), policy)
    steps["routing weights"] = retro_capture_step("routing weights",
                                                   argparse.Namespace(fleet=True, out=None), policy)
    steps["lessons propose"] = retro_capture_step("lessons propose",
                                                  argparse.Namespace(fleet=True, since=args.days,
                                                                     out=None, dry_run=False), policy)
    escalation = retro_capture_step("lessons escalate",
                                    argparse.Namespace(fleet=True, since=args.days, out=None, dry_run=False), policy)
    steps["lessons escalate"] = escalation
    if escalation.get("skipped"):
        notes.append("Skipped lessons escalate: subcommand is not available in this build.")

    compare = retro_capture_step("routing compare", argparse.Namespace(days=args.days, fleet=True), policy)
    steps["routing compare"] = compare
    if compare.get("error"):
        notes.append("routing compare reported: " + retro_safe(compare["error"]))

    entries = [entry for entry in ledger_entries_from(fleet_ledger_path())
               if cutoff <= (to_epoch(entry.get("ts")) or 0) <= now]
    failures = retro_failure_counts(entries)
    rejected = retro_rejected(entries)
    compare_rows = retro_routing_rows(ledger_entries_from(fleet_ledger_path()), cutoff, now)
    proposal_snapshot_after = retro_snapshot_proposals(repo)
    lesson_paths, guard_paths = retro_proposal_changes(proposal_snapshot, proposal_snapshot_after)
    text = retro_report_text(entries, start, end, args.days, policy, notes,
                             lesson_paths, guard_paths, compare_rows)
    # Proposal links are relative to the report location and therefore work with --out too.
    for path in lesson_paths + guard_paths:
        target = urllib.parse.quote(os.path.relpath(os.path.join(repo, path), output_dir).replace(os.sep, "/"),
                                    safe="/-_.~")
        text = text.replace(f"`{retro_safe(path)}`", f"[{retro_safe(os.path.basename(path))}]({target})")
    with open(report_path, "w", encoding="utf-8") as stream:
        stream.write(text)
    summary = {"paths": {"report": report_path, "ledger": fleet_ledger_path(),
                         "routing_weights": routing_weights_path(policy)},
               "counts": {"runs": len(entries), "groups": len(retro_groups(entries)),
                          "failures": sum(retro_is_failure(entry) for entry in entries), "rejected": len(rejected),
                          "exec_pass_null": sum(not isinstance(entry.get("exec_pass"), bool) for entry in entries),
                          "lesson_proposals": len(lesson_paths), "guard_proposals": len(guard_paths),
                          "routing_comparisons": len(compare_rows)},
               "steps": {name: {"ok": result.get("ok", False), "skipped": result.get("skipped", False),
                                "rate_limited": result.get("rate_limited", False)}
                         for name, result in steps.items()},
               "notes": notes}
    print(json.dumps(summary, ensure_ascii=False, sort_keys=True))


def policy_day(policy, date=None):
    name = (policy.get("budget") or {}).get("timezone") or policy.get("timezone")
    tz = ZoneInfo(name) if name else None
    now = dt.datetime.fromtimestamp(NOW(), tz).astimezone(tz)
    day = dt.date.fromisoformat(date) if date else now.date()
    start = dt.datetime.combine(day, dt.time(), tz).astimezone(tz)
    end = dt.datetime.combine(day + dt.timedelta(days=1), dt.time(), tz).astimezone(tz)
    return day.isoformat(), name or str(now.tzinfo), start.timestamp(), end.timestamp()


def executor_seconds(entry):
    attempts = entry.get("attempts") or []
    if attempts:
        return [(a.get("backend") or entry.get("backend") or "unknown", max(0, a.get("seconds") or 0))
                for a in attempts]
    return [(entry.get("backend") or "unknown", max(0, entry.get("seconds") or 0))]


def changed_paths(repo, base, commit, fallback=None):
    if repo and base and commit:
        rc, names, _ = git(["diff", "--name-only", base, commit], repo)
        if rc == 0:
            return [path for path in names.splitlines() if path]
    return list(fallback or [])


READ_ONLY_CARD_TYPES = {"review", "research"}


def read_only_output_exists(root, files):
    root = os.path.realpath(root)
    for path in files if isinstance(files, list) else []:
        if not isinstance(path, str) or not path.strip():
            continue
        candidate = os.path.realpath(path if os.path.isabs(path) else os.path.join(root, path))
        try:
            inside_root = os.path.commonpath((root, candidate)) == root
        except ValueError:
            inside_root = False
        if inside_root and os.path.isfile(candidate):
            return True
    return False


def exec_pass_assessment(changed, read_only_output, verify_requested, verify):
    """Return the pass value and a reason when available evidence is insufficient."""
    if not (changed or read_only_output):
        return False, None
    if isinstance(verify, dict):
        rc = verify.get("rc")
        if isinstance(rc, int) and not isinstance(rc, bool):
            return rc == 0, None
        return None, "verify_result_missing"
    if verify_requested is False:
        return True, None
    if verify_requested is True:
        return False, None
    return None, "verify_request_unknown"


def exec_pass_fields(changed, read_only_output, verify_requested, verify):
    value, reason = exec_pass_assessment(changed, read_only_output, verify_requested, verify)
    return {"exec_pass": value, "exec_pass_reason": reason,
            "exec_pass_changed": bool(changed or read_only_output),
            "read_only_output": bool(read_only_output), "verify_requested": bool(verify_requested)}


def exec_pass_value(_executor_status, changed, read_only_output, verify_requested, verify):
    """Compute execution success from change evidence and host verification, ignoring executor status."""
    return exec_pass_assessment(changed, read_only_output, verify_requested, verify)[0]


def backfill_exec_pass_details(entry):
    status = entry.get("status")
    changed = entry.get("exec_pass_changed") if isinstance(entry.get("exec_pass_changed"), bool) else None
    if changed is None:
        files = entry.get("files_changed")
        file_count = entry.get("files")
        file_count_known = (isinstance(file_count, (int, float)) and not isinstance(file_count, bool)
                            and math.isfinite(file_count) and file_count >= 0)
        has_files = isinstance(files, list) and any(isinstance(path, str) and path.strip() for path in files)
        has_files = has_files or (file_count_known and file_count > 0)
        has_read_only_output = entry.get("read_only_output") is True
        changed = bool(entry.get("commit") or has_files or has_read_only_output)
        if not changed:
            no_change_evidence = (file_count_known and file_count == 0) or (isinstance(files, list) and not files)
            if not no_change_evidence and status in ("done", "partial"):
                return None, "change_evidence_missing"

    if not changed:
        return False, None

    verify = entry.get("verify") if isinstance(entry.get("verify"), dict) else None
    verify_rc = entry.get("verify_rc", verify.get("rc") if verify else None)
    if verify is None and isinstance(verify_rc, int) and not isinstance(verify_rc, bool):
        verify = {"rc": verify_rc}
    verify_requested = entry.get("verify_requested")
    if not isinstance(verify_requested, bool):
        if verify is not None:
            verify_requested = True
        elif status in ("done", "partial") and entry.get("error_class") not in (
                "rate_limit", "risk_blocked", "stopped", "exec_error", "prepare_failed"):
            # These successful terminal statuses run host verification whenever one was requested.
            verify_requested = False
        else:
            verify_requested = None
    return exec_pass_assessment(changed, entry.get("read_only_output") is True, verify_requested, verify)


def backfill_exec_pass(entry):
    return backfill_exec_pass_details(entry)[0]


def budget_status(policy, date=None, entries=None):
    day, timezone, start, end = policy_day(policy, date)
    cfg = policy.get("budget") or {}
    used = {}
    for entry in entries if entries is not None else ledger_entries():
        if start <= (to_epoch(entry.get("ts")) or 0) < end:
            for backend, seconds in executor_seconds(entry):
                used[backend] = used.get(backend, 0) + seconds / 60
    caps = cfg.get("per_backend") or {}
    backends = sorted(set(EXECUTORS) | set(used) | set(caps))
    return {"date": day, "timezone": timezone, "used_minutes": sum(used.values()),
            "cap_minutes": cfg.get("daily_executor_minutes"),
            "per_run_max_minutes": cfg.get("per_run_max_minutes"),
            "per_backend": {b: {"used_minutes": used.get(b, 0), "cap_minutes": caps.get(b)} for b in backends}}


class BudgetExceeded(Exception):
    def __init__(self, detail):
        self.detail = {"ok": False, "error": "budget_exceeded_daily", **detail}


def check_budget(policy, requests, exclude_id=None):
    cfg = policy.get("budget") or {}
    for backend, minutes in requests:
        if not math.isfinite(minutes) or minutes < 0:
            raise ValueError("budget-minutes must be finite and non-negative")
        cap = cfg.get("per_run_max_minutes")
        if cap is not None and minutes > cap:
            raise BudgetExceeded({"scope": "per_run", "backend": backend, "requested_minutes": minutes, "cap_minutes": cap})
    if cfg.get("daily_executor_minutes") is None and not cfg.get("per_backend"):
        return
    snapshot = budget_status(policy)
    reserved = {}
    completed = {e.get("id") for e in ledger_entries()}
    for path in glob.glob(os.path.join(RUNS, "*", "status.json")):
        s = jload(path, {}) or {}
        if s.get("id") == exclude_id or s.get("id") in completed:
            continue
        if s.get("state") not in ("queued", "routing", "running", "finalizing", "verifying") or not pid_alive(s.get("runner_pid")):
            continue
        for b, minutes in s.get("budget_requests") or [(s.get("backend") or "unknown", s.get("budget_minutes") or 0)]:
            reserved[b] = reserved.get(b, 0) + minutes
    requested = {}
    for backend, minutes in requests:
        requested[backend] = requested.get(backend, 0) + minutes
    cap = snapshot["cap_minutes"]
    if cap is not None and snapshot["used_minutes"] + sum(reserved.values()) + sum(requested.values()) > cap:
        raise BudgetExceeded({"scope": "daily", "used_minutes": snapshot["used_minutes"],
                              "reserved_minutes": sum(reserved.values()), "requested_minutes": sum(requested.values()), "cap_minutes": cap})
    for b, minutes in requested.items():
        row = snapshot["per_backend"].get(b, {})
        cap = row.get("cap_minutes")
        if cap is not None and row["used_minutes"] + reserved.get(b, 0) + minutes > cap:
            raise BudgetExceeded({"scope": "backend", "backend": b, "used_minutes": row["used_minutes"],
                                  "reserved_minutes": reserved.get(b, 0), "requested_minutes": minutes, "cap_minutes": cap})


def admit_budget(policy, backend, minutes, rdir, **status):
    os.makedirs(DATA, exist_ok=True)
    requests = status.pop("budget_requests", [(backend, minutes)])
    with open(os.path.join(DATA, "budget.lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        check_budget(policy, requests, exclude_id=status["id"])
        set_status(rdir, backend=backend, budget_minutes=minutes, budget_requests=requests, **status)


def budget_error(error):
    print(json.dumps(error.detail, ensure_ascii=False))
    raise SystemExit(3)


def cmd_budget(args, policy):
    result = budget_status(policy)
    if args.json:
        print(json.dumps(result, indent=2))
        return
    cap = lambda value: "unlimited" if value is None else str(value)
    print(f"Budget {result['date']} ({result['timezone']}): {result['used_minutes']:.2f} / {cap(result['cap_minutes'])} minutes")
    for backend, row in result["per_backend"].items():
        print(f"  {backend}: {row['used_minutes']:.2f} / {cap(row['cap_minutes'])} minutes")

def shift_effort(effort, delta, policy):
    order = policy["efforts"]
    i = order.index(effort) if effort in order else 2
    return order[max(0, min(len(order) - 1, i + delta))]


def clamp_effort(effort, supported, policy):
    """Nearest supported effort, preferring the closest lower one."""
    if not supported:
        return None
    if effort in supported:
        return effort
    order = policy["efforts"]
    want = order.index(effort) if effort in order else 2
    ranked = sorted(supported, key=lambda e: (abs((order.index(e) if e in order else 2) - want),
                                              (order.index(e) if e in order else 2) > want))
    return ranked[0]


TIER_FALLBACK = {"deep": ["deep", "balanced", "fast"], "balanced": ["balanced", "deep", "fast"],
                 "fast": ["fast", "balanced", "deep"]}


def worst_window(windows):
    ws = [w for w in (windows or {}).values() if w]
    return max(ws, key=lambda w: w["used"]) if ws else None


def resets_left(policy):
    """Codex manual quota resets the user still holds (policy.local.json; never consumed automatically)."""
    return int((policy.get("codex") or {}).get("manual_resets_remaining") or 0)


def plan_codex(prof, st, policy, forced, notes):
    cx = st["codex"]
    th = policy["thresholds"]
    if not cx.get("binary"):
        return None, "no working codex binary"
    want = policy["difficulty_map"][str(prof["difficulty"])]
    tier, effort = want["tier"], want["effort"]
    br = breakers()
    for t in TIER_FALLBACK[tier]:
        cands = [m for m in cx["models"] if m["tier"] == t and f"codex/{m['id']}" not in br
                 and f"codex/limit/{m['limit_id']}" not in br]
        cands.sort(key=lambda m: (m["legacy"], m["priority"]))
        if prof.get("context_tokens") and cands:
            cands = [m for m in cands if (m.get("context_window") or 1e9) > prof["context_tokens"] * 1.15] or []
        if not cands:
            continue
        m = cands[0]
        lim = (cx["limits"].get(m["limit_id"]) or {})
        w = worst_window(lim.get("windows"))
        if w:
            if w["used"] >= th["window_hard"]:
                notes.append(f"codex limit {m['limit_id']} at {w['used']:.0%} >= hard {th['window_hard']:.0%}")
                if resets_left(policy):
                    notes.append(f"codex has {resets_left(policy)} manual reset(s) left: ask the user before falling back for long work")
                continue
            if w["used"] >= th["window_soft"] and not forced and prof["difficulty"] <= 3:
                notes.append(f"codex {m['limit_id']} at {w['used']:.0%}: spill difficulty<=3 to other backends")
                continue
            if w["used"] >= th["window_soft"]:
                effort = shift_effort(effort, -1, policy)
                notes.append(f"codex near soft limit ({w['used']:.0%}): effort -1")
            elif w.get("pace") and w["pace"] > th["pace_downgrade"]:
                effort = shift_effort(effort, -1, policy)
                notes.append(f"codex pace {w['pace']}x of even burn: effort -1")
            elif (w.get("hours_to_reset") is not None and w["hours_to_reset"] <= th["upgrade_if_reset_within_hours"]
                  and w["used"] < th["upgrade_if_used_below"]):
                effort = shift_effort(effort, +1, policy)
                notes.append(f"codex window resets in {w['hours_to_reset']}h with {w['used']:.0%} used: effort +1")
        else:
            notes.append("codex quota unknown (no recent rollout); using defaults")
        if t != tier:
            notes.append(f"codex tier {tier} unavailable, using {t}")
        return {"backend": "codex", "model": m["id"], "effort": clamp_effort(effort, m["efforts"], policy),
                "tier": t, "limit_id": m["limit_id"]}, None
    return None, "codex unavailable (limits/breakers)"


def ocgo_pick(prof, st, policy, tier, notes):
    th = policy["thresholds"]
    br = breakers()
    if "ocgo/all" in br:  # plan-wide usage limit: no OpenCode Go model can run
        return None, "ocgo plan usage limit (breaker open)"
    hot = []
    for t in TIER_FALLBACK[tier]:
        cands = []
        for m in st["ocgo"]["models"]:
            if m["excluded"] or m["tier"] != t or f"ocgo/{m['id']}" in br:
                continue
            if prof.get("context_tokens") and (m.get("context") or 1e9) < prof["context_tokens"] * 1.15:
                continue
            u = max(m["usage"].values())
            if u >= th["window_soft"]:
                hot.append(m["id"])
                continue
            cands.append((u, m))
        if cands:
            # newest release first, then most headroom
            cands.sort(key=lambda x: (-(int((x[1].get("release_date") or "0").replace("-", "") or 0)), x[0]))
            if t != tier:
                notes.append(f"ocgo tier {tier} unavailable, using {t}")
            if hot:
                notes.append(f"ocgo skipped {len(hot)} model(s) over {th['window_soft']:.0%} of window budget")
            return cands[0][1], t
    if hot:
        notes.append(f"ocgo: all {len(hot)} candidate model(s) over {th['window_soft']:.0%} of window budget")
    return None, None


def plan_ocgo(prof, st, policy, forced, notes):
    if not st["ocgo"].get("binary"):
        return None, "opencode not installed"
    want = policy["difficulty_map"][str(prof["difficulty"])]
    m, t = ocgo_pick(prof, st, policy, want["tier"], notes)
    if not m:
        return None, "no ocgo model with headroom"
    variant = clamp_effort(want["effort"], m["variants"], policy) if m["variants"] else None
    return {"backend": "ocgo", "model": m["id"], "effort": variant, "tier": t,
            "opencode_model": f"opencode-go/{m['id']}"}, None


def plan_deepseek(prof, st, policy, forced, notes):
    ds = st["deepseek"]
    if ds.get("balance") is None:
        return None, f"deepseek unavailable ({ds.get('error', 'no balance info')})"
    if ds["balance"] < policy["thresholds"]["deepseek_min_balance_cny"]:
        return None, f"deepseek balance {ds['balance']} below floor"
    if f"deepseek/all" in breakers():
        return None, "deepseek breaker open"
    tier = policy["difficulty_map"][str(prof["difficulty"])]["tier"]
    model = policy["deepseek"]["tiers"][tier]
    avail = ds.get("opencode_models") or []
    if avail and model not in avail:
        model = avail[0]
    return {"backend": "deepseek", "model": model, "effort": None, "tier": tier,
            "opencode_model": f"deepseek/{model}"}, None


def cursor_bin():
    """OPENSWARM_CURSOR_BIN, then PATH, then ~/.local/bin/cursor-agent.

    A set OPENSWARM_CURSOR_BIN that is missing or not executable is an error, not a cue to try the next place.
    """
    env_bin = envvar("CURSOR_BIN")
    if env_bin:
        return env_bin if os.access(env_bin, os.X_OK) else None
    found = shutil.which("cursor-agent")
    if found and os.access(found, os.X_OK):
        return found
    home_bin = os.path.expanduser("~/.local/bin/cursor-agent")
    if os.access(home_bin, os.X_OK):
        return home_bin
    return None


def probe_cursor(policy):
    cfg = policy.get("cursor") or {}
    return {"binary": cursor_bin(), "default_model": cfg.get("default_model") or "grok-4.7-high", "quota": None}


def plan_cursor(prof, st, policy, forced, notes):
    known = st.get("cursor") if isinstance(st.get("cursor"), dict) else None
    binary = known.get("binary") if known is not None and "binary" in known else cursor_bin()
    if not binary:
        return None, "no working cursor-agent binary"
    model = prof.get("model") or (policy.get("cursor") or {}).get("default_model") or "grok-4.7-high"
    if f"cursor/{model}" in breakers() or "cursor/all" in breakers():
        return None, "cursor breaker open"
    notes.append("cursor quota unknown (opt-in backend; not metered by openswarm)")
    tier = policy["difficulty_map"][str(prof["difficulty"])]["tier"]
    return {"backend": "cursor", "model": model, "effort": None, "tier": tier}, None


def agy_bin():
    """OPENSWARM_AGY_BIN, then `agy` on PATH, then ~/.local/bin/agy.

    A set OPENSWARM_AGY_BIN that is missing or not executable is an error, not a cue to try the next place.
    """
    env_bin = envvar("AGY_BIN")
    if env_bin:
        return env_bin if os.access(env_bin, os.X_OK) else None
    found = shutil.which("agy")
    if found and os.access(found, os.X_OK):
        return found
    home_bin = os.path.expanduser("~/.local/bin/agy")
    if os.access(home_bin, os.X_OK):
        return home_bin
    return None


def agy_login_state(binary=None):
    """'logged in' / 'not logged in' from a cheap `agy models` call. Credentials are never read or shown."""
    binary = binary or agy_bin()
    if not binary:
        return "unknown"
    if binary in _AGY_LOGIN_CACHE:
        return _AGY_LOGIN_CACHE[binary]
    rc, out, err = sh([binary, "models"], timeout=AGY_LOGIN_TIMEOUT)
    text = f"{out or ''}\n{err or ''}"
    if rc == 0:
        state = "logged in"
    elif AUTH_ERROR_RE.search(text):
        state = "not logged in"
    else:
        state = "unknown"
    _AGY_LOGIN_CACHE[binary] = state
    return state


def agy_status(policy):
    """Binary, default model and login state of the Antigravity CLI (never any credential)."""
    cfg = policy.get("agy") or {}
    binary = agy_bin()
    return {"binary": binary, "default_model": cfg.get("default_model") or AGY_DEFAULT_MODEL,
            "login": agy_login_state(binary)}


def probe_agy(policy):
    cfg = policy.get("agy") or {}
    return {"binary": agy_bin(), "default_model": cfg.get("default_model") or AGY_DEFAULT_MODEL,
            "login": agy_login_state(), "quota": None}


def plan_agy(prof, st, policy, forced, notes):
    known = st.get("agy") if isinstance(st.get("agy"), dict) else None
