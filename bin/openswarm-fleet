#!/bin/sh
# A separate runtime for the executor candidate; it never changes the existing fleet home.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export OPENSWARM_HOME="${OPENSWARM_HOME:-$HOME/.claude/openswarm-executor-candidate}"
export PATH="$HOME/.local/node-v24.14.1/bin:$HOME/tools/copilot-executor/node_modules/.bin:$HOME/.local/bin:/opt/homebrew/bin:$PATH"
if [ -d "$HOME/Library/Application Support/openswarm-copilot" ]; then
  export COPILOT_HOME="${COPILOT_HOME:-$HOME/Library/Application Support/openswarm-copilot}"
fi
if [ -d "$HOME/tools/pi-sandbox/node_modules" ]; then
  export OPENSWARM_PI_RUNTIME="${OPENSWARM_PI_RUNTIME:-$HOME/tools/pi-sandbox}"
fi
exec "$root/bin/openswarm" "$@"
