#!/bin/sh
# Scope the relay to Antigravity. Other OpenSwarm executors keep their own network settings.
set -eu
agy_bin=${OPENSWARM_AGY_REAL_BIN:-"$HOME/.local/bin/agy"}
token_file=${OPENSWARM_AGY_RELAY_TOKEN_FILE:-"$HOME/Library/Application Support/openswarm-agy-relay/token"}
relay_cert=${OPENSWARM_AGY_RELAY_CERT_FILE:-"$HOME/Library/Application Support/openswarm-agy-relay/cert.pem"}
ca_bundle=${OPENSWARM_AGY_RELAY_CA_BUNDLE:-"$HOME/Library/Application Support/openswarm-agy-relay/ca-bundle.pem"}
relay_port=${OPENSWARM_AGY_RELAY_PORT:-18744}
relay_token=''
if [ -r "$token_file" ]; then IFS= read -r relay_token < "$token_file" || :; fi
if [ -n "$relay_token" ] && [ -r "$relay_cert" ] && [ -r "$ca_bundle" ] && printf 'proxy-user = "openbot:%s"\n' "$relay_token" | \
  curl --config - --silent --show-error --head --max-time 5 --noproxy '' \
  --proxy-cacert "$relay_cert" --proxy "https://127.0.0.1:${relay_port}" https://www.googleapis.com/ >/dev/null 2>&1; then
  export SSL_CERT_FILE="$ca_bundle"
  export HTTPS_PROXY="https://openbot:${relay_token}@127.0.0.1:${relay_port}"
  export https_proxy="$HTTPS_PROXY"
else
  printf '%s\n' 'Antigravity relay unavailable; using the existing network settings.' >&2
fi
exec "$agy_bin" "$@"
