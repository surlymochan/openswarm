#!/bin/sh
# Scope the relay to Antigravity. Other OpenSwarm executors keep their own network settings.
set -eu
agy_bin=${OPENSWARM_AGY_REAL_BIN:-"$HOME/.local/bin/agy"}
if curl --silent --show-error --head --max-time 5 --noproxy '' \
  --proxy http://127.0.0.1:18744 https://www.googleapis.com/ >/dev/null 2>&1; then
  export HTTPS_PROXY=http://127.0.0.1:18744
  export https_proxy="$HTTPS_PROXY"
else
  printf '%s\n' 'Antigravity relay unavailable; using the existing network settings.' >&2
fi
exec "$agy_bin" "$@"
