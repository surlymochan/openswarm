#!/usr/bin/env python3
"""Relay one SSH stdio stream to the local broker without exposing a shell."""
import os
import pathlib
import select
import socket

path = pathlib.Path.home() / 'Library' / 'Caches' / 'openswarm-pi-broker' / 'broker.sock'
sock = socket.socket(socket.AF_UNIX)
sock.connect(str(path))
stdin_open = True
while True:
    readers = [sock] + ([0] if stdin_open else [])
    ready, _, _ = select.select(readers, [], [])
    if 0 in ready:
        data = os.read(0, 65536)
        if data:
            sock.sendall(data)
        else:
            stdin_open = False
            sock.shutdown(socket.SHUT_WR)
    if sock in ready:
        data = sock.recv(65536)
        if not data:
            break
        pos = 0
        while pos < len(data):
            pos += os.write(1, data[pos:])
sock.close()
